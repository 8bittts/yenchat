{
	"name": "yenchat",
	"version": "1.297",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.5",
	"engines": {
		"node": "24.x"
	},
	"description": "YEN - The Personal Terminal Experience",
	"scripts": {
		"dev": "lsof -ti:8987 | xargs kill -9 2>/dev/null || true && rm -rf .next && next dev -p 8987",
		"dev:secrets": "infisical secrets-manager run --env=dev --projectId af507451-0829-4a0f-9362-91209db7f241 -- bun dev",
		"build": "bun scripts/44-build-web-csp.ts && bun run check:perf-budget && bun scripts/46-scan-bundle-leaks.ts",
		"check:perf-budget": "bun scripts/perf-budget.ts",
		"scan:client-secrets": "bun scripts/46-scan-bundle-leaks.ts",
		"start": "next start",
		"lint": "bunx biome check",
		"lint:fix": "bunx biome check --write",
		"type-check": "tsc --noEmit",
		"check": "bun run lint && bun run type-check",
		"check:full": "bun run check && bun run build && bun run test:all",
		"prepare": "bun scripts/setup-hooks.ts",
		"format": "bunx biome format --write",
		"knip": "bunx knip",
		"doctor": "bunx react-doctor@latest . --verbose",
		"test": "bun test --parallel=8",
		"test:all": "bun run test && bun run test:policy && bun run test:prod",
		"test:coverage": "bun test --coverage",
		"test:ide-integration": "bun test ./tests/*.integration.ts",
		"test:policy": "bun test ./tests/75-theme-curation-gates.policy.ts ./tests/126-settings-hitch-docs.policy.ts ./tests/154-documentation-contracts.policy.ts",
		"test:prod": "bun test ./tests/10-production.prod.ts"
	},
	"dependencies": {
		"@vercel/analytics": "2.0.1",
		"@vercel/speed-insights": "2.1.1",
		"next": "^16.4.6",
		"next-themes": "^0.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/bun": "^1.4.5",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.11",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@types/sanitize-html": "^2.16.2",
		"happy-dom": "^21.0.4",
		"jsdom": "^31.0.1",
		"knip": "^6.49.0",
		"postcss": "^8.5.34",
		"sanitize-html": "^2.18.2",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2"
	}
}
