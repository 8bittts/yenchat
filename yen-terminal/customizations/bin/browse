#!/bin/bash
# browse - YEN file browser launcher
# Wrapper that hides implementation details from terminal output

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/../lib/macos-version.sh" || exit 1
require_yen_macos || exit 1

RESOURCES_DIR="$(dirname "$SCRIPT_DIR")"

if [ ! -x "$SCRIPT_DIR/yazi" ]; then
    echo "browse: file browser not found at $SCRIPT_DIR/yazi" >&2
    exit 1
fi

YAZI_CONFIG_FALLBACK="$RESOURCES_DIR/yazi-config"
if [ ! -d "$YAZI_CONFIG_FALLBACK" ]; then
    YAZI_CONFIG_FALLBACK="${RESOURCES_DIR%/*}/yazi-config"
fi
if [ ! -d "$YAZI_CONFIG_FALLBACK" ]; then
    echo "browse: yazi config not found at $RESOURCES_DIR/yazi-config" >&2
    exit 1
fi

YAZI_CONFIG_HOME="$YAZI_CONFIG_FALLBACK"
export YAZI_CONFIG_HOME
export PATH="$SCRIPT_DIR:$PATH"
exec "$SCRIPT_DIR/yazi" "$@"
