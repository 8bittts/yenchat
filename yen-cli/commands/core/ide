current_branch_ci_snapshot() {
    local repo="$1"
    local payload=""
    local status=0

    set +e
    payload=$(gh pr view --json number,title,url,isDraft,headRefName,statusCheckRollup 2>/dev/null)
    status=$?
    set -e

    if [[ "${status}" -ne 0 || -z "${payload}" ]]; then
        cat << EOF
available=no
repo=$(watch_state_clean_value "${repo}")
reason=No current-branch pull request detected.
pr_number=0
title=
url=
branch=
is_draft=no
checks_state=unavailable
checks_total=0
checks_passing=0
checks_pending=0
checks_failing=0
completed=no
EOF
        return 0
    fi

    PR_CI_REPO="${repo}" PR_CI_PAYLOAD="${payload}" python3 - <<'PY'
import json
import os
import re


def clean(value):
    return re.sub(r"[\t\r\n]+", " ", str(value or "")).strip()


def flatten_nodes(raw):
    if isinstance(raw, list):
        return raw
    if isinstance(raw, dict):
        for key in ("nodes", "edges", "contexts", "results", "items"):
            value = raw.get(key)
            if isinstance(value, list):
                if key == "edges":
                    return [entry.get("node") for entry in value if isinstance(entry, dict) and entry.get("node")]
                return value
            if isinstance(value, dict):
                nested = flatten_nodes(value)
                if nested:
                    return nested
    return []


payload = json.loads(os.environ.get("PR_CI_PAYLOAD", "{}") or "{}")
checks = {
    "state": "unavailable",
    "passing": 0,
    "pending": 0,
    "failing": 0,
    "total": 0,
}
for item in flatten_nodes(payload.get("statusCheckRollup")):
    if not isinstance(item, dict):
        continue
    state = (
        item.get("conclusion")
        or item.get("status")
        or item.get("state")
        or item.get("rollupState")
        or ""
    ).upper()
    if not state:
        continue
    checks["total"] += 1
    if state in {"SUCCESS", "SUCCESSFUL", "PASS", "PASSED", "EXPECTED", "NEUTRAL", "SKIPPED"}:
        checks["passing"] += 1
    elif state in {"PENDING", "QUEUED", "IN_PROGRESS", "WAITING", "REQUESTED"}:
        checks["pending"] += 1
    else:
        checks["failing"] += 1

if checks["total"] > 0:
    if checks["failing"] > 0:
        checks["state"] = "failing"
    elif checks["pending"] > 0:
        checks["state"] = "pending"
    else:
        checks["state"] = "passing"

print("available=yes")
print(f"repo={clean(os.environ.get('PR_CI_REPO', ''))}")
print("reason=" + clean(
    "Current branch pull request detected."
    if checks["total"] > 0
    else "Current branch pull request has no reported status checks."
))
print(f"pr_number={int(payload.get('number') or 0)}")
print(f"title={clean(payload.get('title') or '')}")
print(f"url={clean(payload.get('url') or '')}")
print(f"branch={clean(payload.get('headRefName') or '')}")
print(f"is_draft={'yes' if payload.get('isDraft') else 'no'}")
print(f"checks_state={checks['state']}")
print(f"checks_total={checks['total']}")
print(f"checks_passing={checks['passing']}")
print(f"checks_pending={checks['pending']}")
print(f"checks_failing={checks['failing']}")
print(f"completed={'yes' if checks['state'] in {'passing', 'failing'} and checks['total'] > 0 else 'no'}")
PY
}

