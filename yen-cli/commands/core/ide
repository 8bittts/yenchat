  - .env loading only accepts KEY=VALUE / export KEY=VALUE lines.
  - Untrusted projects require confirmation before env exports are emitted.
  - LSP runtime uses a local trusted supervisor: it runs an installed reference server when resolution succeeds, or falls back to the placeholder socket daemon with explicit resolver guidance.
  - Diagnostics output is read from the per-project LSP diagnostics snapshot when present, and search now includes diagnostics as a first-class source.
  - Sharing is integration-first: it prefers local upterm, falls back to tmate, encrypts share tokens with a passphrase, and never stores raw terminal output by default.
  - Devcontainer execution never auto-runs; it requires explicit project trust and rejects unsafe spec flags unless --allow-unsafe is set.
  - VS Code import writes only deterministic project-local artifacts under .yen/ and supports a dry-run diff report.
  - AST output is labeled separately from LSP so syntax-aware fallback results never look like live language-server responses.
  - Debugger execution now supports local and ssh://... workspaces plus tracked devcontainer execution on the shared trust/timeline/state model; attach-to-pid flows, TypeScript direct-file launch, Go package debug, Rust package debug, and zero-config adapter installs beyond the shipped Python/Node/LLDB baseline stay blocked until they can be made honest.
  - Workflow execution for untrusted projects requires explicit trust approval.
EOF
}

notify_local() {
    local title="$1"
    local message="$2"
    command -v osascript >/dev/null 2>&1 || return 0
    # Route through DistributedNotificationCenter so YEN.app picks it up
    # and displays with the proper YEN icon (not the generic Script Editor icon).
    # Uses the build notification channel — same as .claude/hooks/notify-complete.sh.
    local payload="${title}
${message}"
    local surface_id="${YEN_SURFACE_ID:-}"
    export YEN_IDE_NOTIFY_PAYLOAD="${payload}"
    export YEN_IDE_NOTIFY_USER_INFO="{\"schema_version\":\"1\",\"service\":\"build\",\"surface_id\":\"${surface_id}\"}"
    osascript -l JavaScript -e '
        ObjC.import("Foundation"); ObjC.import("stdlib");
        var payload = $.NSProcessInfo.processInfo.environment.objectForKey("YEN_IDE_NOTIFY_PAYLOAD").js;
        var userInfo = $();
        var raw = $.NSProcessInfo.processInfo.environment.objectForKey("YEN_IDE_NOTIFY_USER_INFO").js;
        if (raw && raw.length > 0) { try { userInfo = $(JSON.parse(raw)); } catch (e) {} }
        $.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately(
            "com.yenchat.yen.buildNotification", payload, userInfo, true
        );
    ' 2>/dev/null || true
    unset YEN_IDE_NOTIFY_PAYLOAD YEN_IDE_NOTIFY_USER_INFO
}

