non_interference_freeze_field() {
    local field="$1"
    [[ -f "${IDE_NON_INTERFERENCE_FREEZE_FILE}" ]] || return 1
    sed -nE "s/^${field}=(.*)$/\\1/p" "${IDE_NON_INTERFERENCE_FREEZE_FILE}" | head -n 1
}

non_interference_freeze_mode() {
    non_interference_freeze_field "mode"
}

write_non_interference_auto_freeze() {
    local window_days="$1"
    local total="$2"
    local breaches="$3"
    local ratio="$4"
    local budget="$5"
    cat > "${IDE_NON_INTERFERENCE_FREEZE_FILE}" << EOF
mode=auto
activated_at=$(iso_now)
window_days=${window_days}
samples=${total}
breaches=${breaches}
ratio=${ratio}
budget=${budget}
reason=error-budget-exceeded
EOF
}

write_non_interference_manual_freeze() {
    local reason="$1"
    cat > "${IDE_NON_INTERFERENCE_FREEZE_FILE}" << EOF
mode=manual
activated_at=$(iso_now)
reason=${reason}
EOF
}

evaluate_non_interference_budget() {
    local window_days="$1"
    local write_state="${2:-0}"
    local now_epoch
    local cutoff_epoch
    local total=0
    local breaches=0
    local ratio="0.000000"
    local budget
    local min_samples
    local mode="inactive"
    local active="0"
    local manual_mode=""
    local should_freeze="0"

    if [[ ! "${window_days}" =~ ^[0-9]+$ ]] || [[ "${window_days}" -lt 1 ]]; then
        window_days=$(non_interference_default_window_days)
    fi
    budget=$(non_interference_default_error_budget)
    min_samples=$(non_interference_default_min_samples)

    now_epoch=$(date +%s)
    cutoff_epoch=$((now_epoch - (window_days * 86400)))

    if [[ -f "${IDE_NON_INTERFERENCE_SLO_FILE}" ]]; then
        local agg
        agg=$(awk -F'\t' -v cutoff="${cutoff_epoch}" '
            NF >= 6 && $2 ~ /^[0-9]+$/ && $2 >= cutoff {
                total += 1
                if ($6 == "breach") {
                    breaches += 1
                }
            }
            END { printf "%d\t%d", total, breaches }
        ' "${IDE_NON_INTERFERENCE_SLO_FILE}" 2>/dev/null || true)
        if [[ -n "${agg}" ]]; then
            IFS=$'\t' read -r total breaches << EOF
${agg}
EOF
        fi
    fi

    ratio=$(awk -v b="${breaches}" -v t="${total}" 'BEGIN { if (t == 0) { printf "0.000000" } else { printf "%.6f", b / t } }')

    if [[ "${total}" -ge "${min_samples}" ]] && float_gt "${ratio}" "${budget}"; then
        should_freeze="1"
    fi

    manual_mode=$(non_interference_freeze_mode 2>/dev/null || true)
    if [[ "${manual_mode}" == "manual" ]]; then
        mode="manual"
        active="1"
    elif [[ "${should_freeze}" == "1" ]]; then
        mode="auto"
        active="1"
    fi

    if [[ "${write_state}" == "1" ]]; then
        if [[ "${manual_mode}" == "manual" ]]; then
            :
        elif [[ "${should_freeze}" == "1" ]]; then
            write_non_interference_auto_freeze "${window_days}" "${total}" "${breaches}" "${ratio}" "${budget}"
        else
            rm -f "${IDE_NON_INTERFERENCE_FREEZE_FILE}"
        fi
    fi

    printf "%s|%s|%s|%s|%s|%s|%s\n" "${active}" "${mode}" "${total}" "${breaches}" "${ratio}" "${budget}" "${min_samples}"
}

