    ide_require_module "workspace-summary"
    # workspace-summary.sh's detect payload calls doctor_* helpers directly, so
    # omitting this module does not fail — it prints bash "command not found" to
    # stderr and resolves those fields to empty while still exiting 0.
    ide_require_module "workspace-doctor"
}

ide_assert_loaded_function() {
    local function_name="$1"
    if ! declare -F "${function_name}" >/dev/null 2>&1; then
        yen_error "IDE module contract missing required function: ${function_name}"
        exit 1
    fi
}

ide_assert_phase_contracts() {
    local required_function=""
    for required_function in \
        ensure_state_dirs \
        timeline_log \
        cmd_detect \
        cmd_doctor \
        cmd_trust \
        cmd_env \
        cmd_lsp \
        cmd_ast \
        cmd_share \
        cmd_devcontainer \
        cmd_vscode \
        cmd_history \
        cmd_replay \
        cmd_profile \
        cmd_open \
        cmd_debug \
        cmd_benchmark \
        cmd_ports \
        cmd_parse \
        cmd_search \
        cmd_explain \
        cmd_merge_readiness \
        cmd_quality_action \
        cmd_test \
        cmd_verify \
        cmd_workflow
    do
        ide_assert_loaded_function "${required_function}"
    done
}

# Route on the requested subcommand and load only the modules its handler
# transitively needs, so a trivial `yen ide ports` no longer pays the full
# ~22-module parse. Unlisted/heavy subcommands fall through to the full suite
# below (unchanged behavior). `detect` keeps its own fast path above.
ide_require_command_modules() {
    case "$1" in
        ""|-h|--help|help|timeline)
            ide_require_module common ;;
        gate|non-interference|noninterference|slo)
            ide_require_module_list common workspace-identity state-trust timeline ;;
        pr-notify|pr-watch)
            ide_require_module_list common workspace-identity state-trust timeline reports ;;
        parse)
            ide_require_module_list common search-history ;;
        open)
            ide_require_module_list common editor-handoff ;;
        history|replay)
            ide_require_module_list common workspace-identity state-trust search-history ;;
        ports|profile)
            ide_require_module_list common workspace-identity state-trust timeline search-history ;;
        benchmark)
            ide_require_module_list common workspace-identity state-trust timeline benchmark ;;
        explain)
            ide_require_module_list common workspace-identity state-trust timeline search-history workspace-capabilities ;;
        env)
            ide_require_module_list common workspace-identity state-trust timeline reports env ;;
        vscode)
            ide_require_module_list common workspace-identity state-trust timeline workflow-quality vscode ;;
        format|fmt|lint|fix)
            ide_require_module_list common workspace-identity state-trust timeline search-history workflow-quality quality ;;
        share)
            ide_require_module_list common workspace-identity state-trust timeline env workflow-quality workspace-summary workspace-doctor share ;;
        devcontainer)
            ide_require_module_list common workspace-identity state-trust timeline reports env workflow-quality workspace-summary workspace-doctor devcontainer ;;
        workflow|workflows)
            ide_require_module_list common workspace-identity state-trust timeline env search-history quality workflow-quality workspace-summary workspace-doctor ;;
        *)
            # doctor, trust, ast, lsp, debug, search, test, verify,
            # merge-readiness, pr-review, and any unrecognized subcommand
            # still load the complete IDE suite (unchanged behavior + contract assert).
            ide_require_phase2_modules
            ide_require_phase3_modules
            ide_require_phase4_modules
            ide_require_phase5_modules
            ide_assert_phase_contracts
            ;;
    esac
}

ide_require_phase1_modules

# Shell integration calls `yen ide detect --cached --format env` before the first prompt.
# Keep that path on a minimal bootstrap so startup doesn't pay for the full IDE suite.
case "${1:-}" in
    detect|project)
        ide_require_detect_modules
        shift
        cmd_detect "$@"
        exit $?
        ;;
esac

ide_require_command_modules "${1:-}"

is_number_value() {
    local value="$1"
    printf "%s" "${value}" | grep -Eq '^-?[0-9]+([.][0-9]+)?$'
}

float_gt() {
    local left="$1"
    local right="$2"
    awk -v left="${left}" -v right="${right}" 'BEGIN { if (left > right) exit 0; exit 1 }'
}

non_interference_default_window_days() {
    local raw="${YEN_IDE_NON_INTERFERENCE_WINDOW_DAYS:-30}"
    if [[ ! "${raw}" =~ ^[0-9]+$ ]] || [[ "${raw}" -lt 1 ]]; then
        raw="30"
    fi
    printf "%s\n" "${raw}"
}

non_interference_default_error_budget() {
    local raw="${YEN_IDE_NON_INTERFERENCE_ERROR_BUDGET:-0.05}"
    if ! is_number_value "${raw}" || ! awk -v v="${raw}" 'BEGIN { if (v > 0 && v <= 1) exit 0; exit 1 }'; then
        raw="0.05"
    fi
    printf "%s\n" "${raw}"
}

non_interference_default_min_samples() {
    local raw="${YEN_IDE_NON_INTERFERENCE_MIN_SAMPLES:-20}"
    if [[ ! "${raw}" =~ ^[0-9]+$ ]] || [[ "${raw}" -lt 1 ]]; then
        raw="20"
    fi
    printf "%s\n" "${raw}"
}

