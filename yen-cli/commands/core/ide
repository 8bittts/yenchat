record_pr_ci_transition() {
    local root="$1"
    local snapshot="$2"
    local state_file=""
    local previous=""
    local previous_state=""
    local previous_number=""
    local current_available=""
    local current_state=""
    local current_number=""
    local current_title=""
    local current_repo=""
    local current_completed=""
    local current_url=""

    state_file=$(pr_ci_state_file "${root}")
    if [[ -f "${state_file}" ]]; then
        previous=$(cat "${state_file}")
        previous_state=$(doctor_snapshot_value "${previous}" "checks_state")
        previous_number=$(doctor_snapshot_value "${previous}" "pr_number")
    fi

    current_available=$(doctor_snapshot_value "${snapshot}" "available")
    current_state=$(doctor_snapshot_value "${snapshot}" "checks_state")
    current_number=$(doctor_snapshot_value "${snapshot}" "pr_number")
    current_title=$(doctor_snapshot_value "${snapshot}" "title")
    current_repo=$(doctor_snapshot_value "${snapshot}" "repo")
    current_completed=$(doctor_snapshot_value "${snapshot}" "completed")
    current_url=$(doctor_snapshot_value "${snapshot}" "url")

    if [[ "${current_available}" == "yes" ]]; then
        if [[ "${current_state}" != "${previous_state}" || "${current_number}" != "${previous_number}" ]]; then
            timeline_log "pr-ci" "${root}" "${current_state}" "repo=${current_repo};pr=${current_number};url=${current_url};pass=$(doctor_snapshot_value "${snapshot}" "checks_passing");pending=$(doctor_snapshot_value "${snapshot}" "checks_pending");fail=$(doctor_snapshot_value "${snapshot}" "checks_failing")"
            if [[ "${current_completed}" == "yes" && "${current_state}" != "${previous_state}" && ( "${current_state}" == "passing" || "${current_state}" == "failing" ) ]]; then
                notify_local "YEN PR CI ${current_state}" "${current_repo} #${current_number}: ${current_title}"
            fi
        fi
    elif [[ -n "${previous_state}" && "${previous_state}" != "unavailable" ]]; then
        timeline_log "pr-ci" "${root}" "unavailable" "reason=$(doctor_snapshot_value "${snapshot}" "reason")"
    fi

    atomic_write_text "${state_file}" "${snapshot}"
}

fetch_pr_file_diff_via_api() {
    local repo_slug="$1"
    local pr_number="$2"
    local target_file="$3"

    if [[ -z "${repo_slug}" || -z "${pr_number}" || -z "${target_file}" ]]; then
        return 1
    fi

    local escaped_target
    escaped_target=$(jq_escape_string "${target_file}")
    local patch
    patch=$(gh api "repos/${repo_slug}/pulls/${pr_number}/files?per_page=100" \
        --paginate \
        --jq ".[] | select(.filename == \"${escaped_target}\" or (.previous_filename // \"\") == \"${escaped_target}\") | .patch" 2>/dev/null || true)
    if [[ -z "${patch}" ]]; then
        return 1
    fi

    printf "diff --git a/%s b/%s\n" "${target_file}" "${target_file}"
    printf "%s\n" "${patch}"
}

extract_pr_file_diff() {
    local full_diff="$1"
    local target_file="$2"
    printf "%s\n" "${full_diff}" | awk -v target="${target_file}" '
        BEGIN {
            in_block = 0
            found = 0
        }
        {
            if (index($0, "diff --git ") == 1) {
                apath = $3
                bpath = $4
                sub(/^a\//, "", apath)
                sub(/^b\//, "", bpath)
                in_block = (apath == target || bpath == target)
                if (in_block) {
                    found = 1
                }
            }
            if (in_block) {
                print
            }
        }
        END {
            if (!found) {
                exit 1
            }
        }
    '
}

