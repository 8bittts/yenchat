        lsp-start-ms)
            printf "%s\n" "${YEN_IDE_SLO_LSP_START_MS:-1500}"
            ;;
        verify-duration-ms)
            printf "%s\n" "${YEN_IDE_SLO_VERIFY_DURATION_MS:-4000}"
            ;;
        orchestration-latency-ms)
            printf "%s\n" "${YEN_IDE_SLO_ORCHESTRATION_LATENCY_MS:-1200}"
