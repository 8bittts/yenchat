    case "${metric}" in
        key-to-echo-p95-ms|key_to_echo_p95_ms|p95)
            printf "key-to-echo-p95-ms\n"
            ;;
        key-to-echo-p99-ms|key_to_echo_p99_ms|p99)
            printf "key-to-echo-p99-ms\n"
            ;;
        search-latency-ms|search_latency_ms|search)
            printf "search-latency-ms\n"
            ;;
        lsp-start-ms|lsp_start_ms|lsp)
            printf "lsp-start-ms\n"
            ;;
        verify-duration-ms|verify_duration_ms|verify)
            printf "verify-duration-ms\n"
            ;;
        orchestration-latency-ms|orchestration_latency_ms|orchestration)
            printf "orchestration-latency-ms\n"
            ;;
        startup-regression-ms|startup_regression_ms|startup)
            printf "startup-regression-ms\n"
            ;;
        idle-cpu-overhead-pct|idle_cpu_overhead_pct|cpu)
