parse_inline_ref() {
    local ref="$1"
    if [[ "${ref}" =~ ^(.+):([0-9]+):([Ll][Ee][Ff][Tt]|[Rr][Ii][Gg][Hh][Tt])$ ]]; then
        printf "%s\t%s\t%s\n" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "$(printf "%s" "${BASH_REMATCH[3]}" | tr '[:lower:]' '[:upper:]')"
        return 0
    fi
    if [[ "${ref}" =~ ^(.+):([0-9]+)$ ]]; then
        printf "%s\t%s\tRIGHT\n" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        return 0
    fi
    return 1
}

