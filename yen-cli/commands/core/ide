    if declare -F render_evidence_status_markdown_section_for_root >/dev/null 2>&1; then
        evidence_status_timeline=$(mktemp)
        if [[ -f "${IDE_TIMELINE_FILE}" ]]; then
            cp "${IDE_TIMELINE_FILE}" "${evidence_status_timeline}"
