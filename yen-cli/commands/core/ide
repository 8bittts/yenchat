agent_review_notes_markdown_for_root() {
    local root="$1"
    local max_notes="${2:-4}"
    local agents_state_dir="${YEN_AGENTS_STATE_DIR:-$HOME/.config/yen/agents}"
    local notes_dir="${agents_state_dir}/notes"

    [[ -d "${notes_dir}" ]] || return 0

    AGENT_REVIEW_ROOT="${root}" \
    AGENT_REVIEW_NOTES_DIR="${notes_dir}" \
    AGENT_REVIEW_MAX="${max_notes}" \
    python3 - <<'PY'
import os
import pathlib
import sys


def clean(value):
    return str(value or "").replace("\t", " ").replace("\r", " ").replace("\n", " ").strip()


def read_kv(path):
    payload = {}
    try:
        raw = path.read_text(encoding="utf-8")
    except Exception:
        return payload
    for line in raw.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        payload[key] = value
    return payload


root = os.path.realpath(os.environ.get("AGENT_REVIEW_ROOT", "").strip())
notes_dir = pathlib.Path(os.environ.get("AGENT_REVIEW_NOTES_DIR", "").strip())
try:
    max_notes = max(1, int(os.environ.get("AGENT_REVIEW_MAX", "4") or "4"))
except Exception:
    max_notes = 4

rows = []
if root and notes_dir.is_dir():
    for state_path in notes_dir.glob("*.state"):
        payload = read_kv(state_path)
        if not payload:
            continue
        project_root = payload.get("project_root", "").strip()
        if not project_root or os.path.realpath(project_root) != root:
            continue
        kind = payload.get("kind", "").strip()
        if kind not in {"approval", "handoff"}:
            continue
        message = ""
        message_path = state_path.with_suffix(".txt")
        if message_path.is_file():
            try:
                message = message_path.read_text(encoding="utf-8")
            except Exception:
                message = ""
        rows.append(
            {
                "noteId": payload.get("note_id", state_path.stem),
                "createdAt": clean(payload.get("created_at")),
                "actor": clean(payload.get("actor")),
                "kind": kind,
                "decision": clean(payload.get("decision")),
                "template": clean(payload.get("template")),
                "title": clean(payload.get("title")),
                "sessionId": clean(payload.get("session_id")),
                "slotId": clean(payload.get("slot_id")),
                "linkValidated": payload.get("link_validated", "") == "yes",
                "message": clean(message),
            }
        )

rows.sort(key=lambda item: (item.get("createdAt") or "", item.get("noteId") or ""), reverse=True)
rows = rows[:max_notes]

if not rows:
    raise SystemExit(0)

print("## Agent Handoff Context")
print("")
for row in rows:
    label = row["kind"]
    if row["kind"] == "approval" and row.get("decision"):
        label = f"{label}:{row['decision']}"
    extras = []
    if row.get("actor"):
        extras.append(f"actor={row['actor']}")
    if row.get("slotId"):
        extras.append(f"slot={row['slotId']}")
    if row.get("sessionId"):
        extras.append(f"session={row['sessionId']}")
    if row.get("template"):
        extras.append(f"template={row['template']}")
    if row.get("linkValidated"):
        extras.append("link=validated")
    suffix = f" | {'; '.join(extras)}" if extras else ""
    print(f"- {row.get('createdAt') or '-'} | {label} | {row.get('title') or '-'}{suffix}")
    print(f"  - Message: {row.get('message') or '-'}")
print("")
PY
}

write_pr_evidence_bundle() {
