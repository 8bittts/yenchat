#!/bin/bash
# YEN IDE Command
# S1 foundation tools:
# - project detection
# - trusted env loading
# - project-scoped history + replay
# - command profiling + port/process snapshot
# - semantic output reference parsing

source "${YEN_LIB}/init.sh"
yen_require git-review-tools

IDE_STATE_DIR="${YEN_IDE_STATE_DIR:-$HOME/.config/yen/ide}"
IDE_TRUST_FILE="${IDE_STATE_DIR}/trusted-env-projects"
