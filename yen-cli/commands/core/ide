        IDE_TIMELINE_FILE="${evidence_status_timeline}"
        evidence_status_section=$(render_evidence_status_markdown_section_for_root "${root}" || true)
        IDE_TIMELINE_FILE="${original_timeline_file}"
        rm -f "${evidence_status_timeline}"
    fi

    {
        echo "# YEN IDE PR Review Evidence"
        echo ""
        echo "- Generated: $(iso_now)"
        echo "- Project root: ${root}"
        echo "- PR: #${pr_number}"
        echo "- Title: ${pr_title}"
        echo "- URL: ${pr_url}"
        echo "- Author: ${pr_author}"
        echo "- Base -> Head: ${pr_base} -> ${pr_head}"
        echo "- Diff stats: ${pr_add} additions, ${pr_del} deletions, ${pr_changed} files"
        if [[ -n "${selected_file}" ]]; then
            echo "- Focus file: ${selected_file}"
        fi
        if [[ -n "${focus_target}" ]]; then
            echo "- Focus target: ${focus_target}"
        fi
        if [[ -n "${focus_hunk_header}" ]]; then
            echo "- Focus hunk: ${focus_hunk_header}"
        fi
        echo ""
        echo "## Changed Files"
        printf "%s\n" "${files}" | head -n 120 | sed 's/^/- /'
        echo ""

        if [[ -n "${review_markdown}" ]]; then
            printf "%s\n" "${review_markdown}"
        fi

        if [[ -n "${agent_notes_markdown}" ]]; then
            printf "%s\n" "${agent_notes_markdown}"
        fi

        if [[ -n "${evidence_status_section}" ]]; then
            printf "%s\n\n" "${evidence_status_section}"
        fi

        if [[ -n "${latest_verify_status_section}" ]]; then
            printf "%s\n\n" "${latest_verify_status_section}"
        fi

        if [[ -n "${latest_verify}" ]]; then
            echo "## Latest Verify Summary Path"
            echo ""
            echo "- ${latest_verify}"
            echo ""
            if [[ -f "${latest_verify}" ]]; then
                echo "## Latest Verify Summary (TSV)"
                echo ""
                echo '```tsv'
                cat "${latest_verify}"
                echo '```'
                echo ""
            fi
        fi

        if [[ -n "${timeline_tail}" ]]; then
            echo "## Recent IDE Timeline Events"
            echo ""
            echo '```text'
            printf "%s\n" "${timeline_tail}"
            echo '```'
            echo ""
        fi
    } > "${evidence_file}"
}

