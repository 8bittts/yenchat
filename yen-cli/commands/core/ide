    local inline_body=""
    local focus_target=""
    local focus_hunk_header=""
    local hunk_path=""
    local hunk_line=""
    local hunk_col="1"
    local review_context_json=""
    local review_context_block=""
    local -a review_targets=()
    local root

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pick)
                pick="1"
                ;;
            --loop)
                loop_mode="1"
                ;;
            --loop-script=*)
                loop_script="${1#*=}"
                ;;
            --loop-script)
                shift
                loop_script="${1:-}"
                ;;
            --file)
                shift
                file_override="${1:-}"
                ;;
            --list-hunks)
                list_hunks="1"
                ;;
            --hunk)
                shift
                hunk_ref="${1:-}"
                ;;
            --no-diff)
                no_diff="1"
                ;;
            --decision)
                shift
                decision_mode="${1:-}"
                ;;
            --note)
                shift
                user_note="${1:-}"
                ;;
            --inline)
                shift
                inline_ref="${1:-}"
                ;;
            --inline-body|--comment-body)
                shift
                inline_body="${1:-}"
                ;;
            --evidence)
                make_evidence="1"
                explicit_evidence="1"
                ;;
            --post)
                post_evidence="1"
                make_evidence="1"
                ;;
            *)
                if [[ -z "${pr_arg}" ]]; then
                    pr_arg="$1"
                else
                    yen_error "Unknown pr-review option/arg: $1"
                    exit 1
                fi
                ;;
        esac
        shift
    done

    if [[ -n "${decision_mode}" ]]; then
        decision_mode=$(printf "%s" "${decision_mode}" | tr '[:upper:]' '[:lower:]' | tr '_' '-')
        case "${decision_mode}" in
            approve|request-changes|comment)
                ;;
            *)
                yen_error "Invalid decision mode: ${decision_mode} (use approve|request-changes|comment)"
                exit 1
                ;;
        esac
    fi

    if [[ -n "${loop_script}" && "${loop_mode}" != "1" ]]; then
        yen_error "--loop-script requires --loop."
        exit 1
    fi

    if [[ "${loop_mode}" == "1" && "${list_hunks}" == "1" ]]; then
        yen_error "--loop cannot be combined with --list-hunks."
        exit 1
    fi
    if [[ "${loop_mode}" == "1" && -n "${hunk_ref}" ]]; then
        yen_error "--loop cannot be combined with --hunk."
        exit 1
    fi
    if [[ "${list_hunks}" == "1" && ("${make_evidence}" == "1" || "${post_evidence}" == "1" || -n "${decision_mode}" || -n "${inline_ref}") ]]; then
        yen_error "--list-hunks is read-only and cannot be combined with evidence, posting, decisions, or inline comments."
        exit 1
    fi
    if [[ -n "${hunk_ref}" && "${no_diff}" == "1" ]]; then
        yen_error "--hunk cannot be combined with --no-diff."
        exit 1
    fi

    if ! command -v gh >/dev/null 2>&1; then
        yen_error "GitHub CLI (gh) is required for pr-review."
        exit 1
    fi

    root=$(find_project_root "${PWD}")
    local pr_number
    pr_number=$(resolve_pr_number "${pr_arg}")
    if [[ -z "${pr_number}" ]]; then
        yen_error "Could not resolve PR number. Pass one explicitly: yen ide pr-review <number>"
        exit 1
    fi
    local repo_slug
    repo_slug=$(gh_repo_slug)
    if [[ -z "${repo_slug}" ]]; then
        yen_error "Unable to resolve GitHub repository context for pr-review."
        exit 1
    fi

    local meta
    meta=$(gh pr view "${pr_number}" \
        --json number,title,url,headRefName,baseRefName,headRefOid,author,changedFiles,additions,deletions \
        --jq '[.number,.title,.url,.headRefName,.baseRefName,.headRefOid,.author.login,.changedFiles,.additions,.deletions] | @tsv' 2>/dev/null || true)
    if [[ -z "${meta}" ]]; then
        yen_error "Unable to load PR #${pr_number}. Verify repo context and gh authentication."
        exit 1
    fi

    local pr_title
    local pr_url
    local pr_head
    local pr_base
    local pr_head_oid
    local pr_author
    local pr_changed
    local pr_add
    local pr_del
    IFS=$'\t' read -r _ pr_title pr_url pr_head pr_base pr_head_oid pr_author pr_changed pr_add pr_del << EOF
${meta}
EOF

    local files
    files=$(gh pr diff "${pr_number}" --name-only 2>/dev/null || true)

    echo ""
    yen_header "IDE PR Review"
    echo "PR:         #${pr_number}"
    echo "Title:      ${pr_title}"
    echo "Author:     ${pr_author}"
    echo "Base->Head: ${pr_base} -> ${pr_head}"
    echo "Diff stats: +${pr_add} / -${pr_del} across ${pr_changed} files"
    echo "URL:        ${pr_url}"
    echo ""

    local -a file_list=()
    local fline=""
    while IFS= read -r fline; do
        [[ -n "${fline}" ]] && file_list+=("${fline}")
    done << EOF
${files}
EOF

    if [[ "${loop_mode}" == "1" && "${no_diff}" == "1" ]]; then
        yen_error "--loop cannot be combined with --no-diff."
        exit 1
    fi
    if [[ "${loop_mode}" == "1" && -n "${decision_mode}" ]]; then
        yen_error "--loop cannot be combined with --decision. Use loop actions (a/r/c) instead."
        exit 1
    fi

    if [[ "${loop_mode}" == "1" && -z "${loop_script}" && (! -t 0 || ! -t 1) ]]; then
        yen_error "--loop requires an interactive terminal."
        exit 1
    fi

    local selected_file="${file_override}"
    if [[ -n "${hunk_ref}" ]]; then
        local parsed_hunk=""
        parsed_hunk=$(yen_git_review_parse_location_ref "${hunk_ref}" || true)
        if [[ -z "${parsed_hunk}" ]]; then
            yen_error "Invalid --hunk value '${hunk_ref}'. Use path:line[:col]."
            exit 1
        fi
        IFS=$'\t' read -r hunk_path hunk_line hunk_col << EOF
${parsed_hunk}
EOF
        if [[ -n "${selected_file}" && "${selected_file}" != "${hunk_path}" ]]; then
            yen_error "--file and --hunk must point to the same file."
            exit 1
        fi
        selected_file="${hunk_path}"
        focus_target="${hunk_path}:${hunk_line}:${hunk_col}"
    fi

    if [[ -z "${selected_file}" && "${pick}" == "1" ]]; then
        selected_file=$(select_pr_file_interactive "${files}" || true)
        if [[ -z "${selected_file}" ]]; then
            yen_error "No file selected."
            exit 1
        fi
    fi

    if [[ "${list_hunks}" != "1" && "${no_diff}" != "1" && -z "${selected_file}" && ${#file_list[@]} -gt 0 ]]; then
        selected_file="${file_list[0]}"
    fi

    if declare -F review_context_json_for_targets >/dev/null 2>&1; then
        if [[ -n "${focus_target}" ]]; then
            review_targets+=("${focus_target}")
        elif [[ -n "${selected_file}" ]]; then
            review_targets+=("${selected_file}")
        else
            local context_file=""
            for context_file in "${file_list[@]}"; do
                review_targets+=("${context_file}")
                [[ ${#review_targets[@]} -ge 5 ]] && break
            done
        fi
        if [[ ${#review_targets[@]} -gt 0 ]]; then
            review_context_json=$(review_context_json_for_targets "${root}" "${review_targets[@]}")
            review_context_block=$(review_context_text_block_from_json "${review_context_json}" "5" "  " || true)
        fi
    fi

    if [[ -n "${review_context_block}" ]]; then
        echo "Review routing:"
        printf "%s\n" "${review_context_block}"
        echo ""
    fi

    local inline_path=""
    local inline_line=""
    local inline_side=""
    if [[ -n "${inline_ref}" ]]; then
        local parsed_inline
        parsed_inline=$(parse_inline_ref "${inline_ref}" || true)
        if [[ -z "${parsed_inline}" ]]; then
            yen_error "Invalid --inline value '${inline_ref}'. Use path:line[:LEFT|RIGHT]."
            exit 1
        fi
        IFS=$'\t' read -r inline_path inline_line inline_side << EOF
${parsed_inline}
EOF
        if [[ -z "${selected_file}" ]]; then
            selected_file="${inline_path}"
        fi
        if [[ -z "${inline_body}" ]]; then
            inline_body="${user_note}"
        fi
        if [[ "${post_evidence}" == "1" && -z "${decision_mode}" && "${explicit_evidence}" != "1" ]]; then
            make_evidence="0"
        fi
    fi

    local full_diff_fallback=""
    local file_diff=""
    local script_mode="0"
    local -a scripted_actions=()
    local script_index=0
    if [[ -n "${loop_script}" ]]; then
        script_mode="1"
        IFS=',' read -r -a scripted_actions <<< "${loop_script}"
    fi

    if [[ "${list_hunks}" == "1" ]]; then
        if [[ -z "${full_diff_fallback}" ]]; then
            full_diff_fallback=$(gh pr diff "${pr_number}" 2>/dev/null || true)
        fi
        local hunk_rows=""
        hunk_rows=$(printf "%s\n" "${full_diff_fallback}" | yen_git_review_emit_hunk_rows "${selected_file}")
        echo "PR Review Hunk Targets"
        if [[ -n "${selected_file}" ]]; then
            echo "File: ${selected_file}"
        fi
        echo ""
        yen_git_review_print_hunk_rows_table "${hunk_rows}"
        echo ""
        timeline_log "pr-review-hunks" "${root}" "pr=${pr_number}" "file=${selected_file};target=${focus_target}"
        return 0
    fi

    if [[ "${loop_mode}" == "1" ]]; then
        if [[ ${#file_list[@]} -eq 0 ]]; then
            yen_error "No changed files found for interactive review."
            exit 1
        fi

        local file_index="0"
        if [[ -n "${selected_file}" ]]; then
            local idx
            for idx in "${!file_list[@]}"; do
                if [[ "${file_list[$idx]}" == "${selected_file}" ]]; then
                    file_index="${idx}"
                    break
                fi
            done
        fi

        local loop_done="0"
        while [[ "${loop_done}" != "1" ]]; do
            selected_file="${file_list[$file_index]}"
            file_diff=$(fetch_pr_file_diff_via_api "${repo_slug}" "${pr_number}" "${selected_file}" || true)
            if [[ -z "${file_diff}" ]]; then
                if [[ -z "${full_diff_fallback}" ]]; then
                    full_diff_fallback=$(gh pr diff "${pr_number}" 2>/dev/null || true)
                fi
                file_diff=$(extract_pr_file_diff "${full_diff_fallback}" "${selected_file}" || true)
            fi
            echo "Focused diff [$((file_index + 1))/${#file_list[@]}]: ${selected_file}"
            echo ""
            if [[ -n "${file_diff}" ]]; then
                yen_git_review_show_diff_text "${file_diff}"
            else
                yen_warn "No focused diff block found for file: ${selected_file}"
            fi

            echo ""
            local action=""
            if [[ "${script_mode}" == "1" ]]; then
                if [[ "${script_index}" -lt "${#scripted_actions[@]}" ]]; then
                    action=$(trim "${scripted_actions[$script_index]}")
                    script_index=$((script_index + 1))
                else
                    action="q"
                fi
                echo "pr-review(script)> ${action}"
            else
                echo "Actions: [n]ext [p]rev [s]elect [e]vidence [a]pprove [r]equest-changes [c]omment [q]uit"
                echo "Script actions: s:<index> f:<path> (use with --loop-script)"
                printf "pr-review> "
                read -r action
            fi
            case "${action}" in
                n|N|next)
                    file_index=$((file_index + 1))
                    if [[ "${file_index}" -ge "${#file_list[@]}" ]]; then
                        file_index="0"
                    fi
                    ;;
                p|P|prev)
                    if [[ "${file_index}" -le 0 ]]; then
                        file_index=$((${#file_list[@]} - 1))
                    else
                        file_index=$((file_index - 1))
                    fi
                    ;;
                s|S|select)
                    if [[ "${script_mode}" == "1" ]]; then
                        yen_warn "Scripted mode requires explicit s:<index> or f:<path> selection."
                    else
                        local picked
                        picked=$(select_pr_file_interactive "${files}" || true)
                        if [[ -n "${picked}" ]]; then
                            local i
                            for i in "${!file_list[@]}"; do
                                if [[ "${file_list[$i]}" == "${picked}" ]]; then
                                    file_index="${i}"
                                    break
                                fi
                            done
                        fi
                    fi
                    ;;
                s:*)
                    local raw_index="${action#s:}"
                    if [[ "${raw_index}" =~ ^[0-9]+$ ]] && [[ "${raw_index}" -ge 1 ]] && [[ "${raw_index}" -le "${#file_list[@]}" ]]; then
                        file_index=$((raw_index - 1))
                    else
                        yen_warn "Invalid scripted select index: ${raw_index}"
                    fi
                    ;;
                f:*)
                    local requested_path="${action#f:}"
                    local found_index="-1"
                    local i_match
                    for i_match in "${!file_list[@]}"; do
                        if [[ "${file_list[$i_match]}" == "${requested_path}" ]]; then
                            found_index="${i_match}"
                            break
                        fi
                    done
                    if [[ "${found_index}" -ge 0 ]]; then
                        file_index="${found_index}"
                    else
                        yen_warn "Scripted file not found in PR diff: ${requested_path}"
                    fi
                    ;;
                e|E|evidence)
                    make_evidence="1"
                    ;;
                a|A|approve)
                    decision_mode="approve"
                    ;;
                r|R|request|request-changes)
                    decision_mode="request-changes"
                    ;;
                c|C|comment)
                    decision_mode="comment"
                    ;;
                q|Q|quit)
                    loop_done="1"
                    ;;
                *)
                    ;;
            esac

            if [[ "${make_evidence}" == "1" ]]; then
                local ts_ev
                ts_ev=$(date -u +"%Y%m%dT%H%M%SZ")
                local ev_path="${IDE_EVIDENCE_DIR}/pr-${pr_number}-${ts_ev}.md"
                write_pr_evidence_bundle \
                    "${root}" "${pr_number}" "${pr_title}" "${pr_url}" "${pr_author}" "${pr_base}" "${pr_head}" \
                    "${pr_changed}" "${pr_add}" "${pr_del}" "${files}" "${selected_file}" "${focus_target}" "${focus_hunk_header}" "${ev_path}"
                yen_success "Wrote PR evidence bundle: ${ev_path}"
                timeline_log "pr-evidence" "${root}" "pr=${pr_number}" "file=${selected_file};target=${focus_target};path=${ev_path}"
                make_evidence="0"
            fi

            if [[ -n "${decision_mode}" ]]; then
                local ts_dec
                ts_dec=$(date -u +"%Y%m%dT%H%M%SZ")
                local decision_file="${IDE_EVIDENCE_DIR}/pr-${pr_number}-decision-${decision_mode}-${ts_dec}.md"
                write_pr_decision_template \
                    "${decision_mode}" "${root}" "${pr_number}" "${pr_title}" "${pr_url}" "${selected_file}" "${focus_target}" "" "${user_note}" "${decision_file}"
                yen_success "Wrote PR decision template: ${decision_file}"
                if [[ "${post_evidence}" == "1" ]]; then
                    submit_pr_decision "${pr_number}" "${decision_mode}" "${decision_file}"
                    yen_success "Posted ${decision_mode} review for PR #${pr_number}"
                fi
                timeline_log "pr-decision" "${root}" "pr=${pr_number};mode=${decision_mode}" "file=${selected_file};target=${focus_target};post=${post_evidence};artifact=${decision_file}"
                decision_mode=""
            fi
        done
    elif [[ "${no_diff}" != "1" && -n "${selected_file}" ]]; then
        file_diff=$(fetch_pr_file_diff_via_api "${repo_slug}" "${pr_number}" "${selected_file}" || true)
        if [[ -z "${file_diff}" ]]; then
            if [[ -z "${full_diff_fallback}" ]]; then
                full_diff_fallback=$(gh pr diff "${pr_number}" 2>/dev/null || true)
            fi
            file_diff=$(extract_pr_file_diff "${full_diff_fallback}" "${selected_file}" || true)
        fi
        if [[ -z "${file_diff}" ]]; then
            yen_warn "No focused diff block found for file: ${selected_file}"
        elif [[ -n "${hunk_ref}" ]]; then
            local hunk_rows=""
            local matched_row=""
            local focused_hunk_diff=""
            hunk_rows=$(printf "%s\n" "${file_diff}" | yen_git_review_emit_hunk_rows "${selected_file}")
            matched_row=$(printf "%s\n" "${hunk_rows}" | yen_git_review_find_hunk_row_for_line "${selected_file}" "${hunk_line}" || true)
            if [[ -z "${matched_row}" ]]; then
                yen_error "No focused diff hunk found for ${selected_file}:${hunk_line}:${hunk_col}."
                exit 1
            fi
            IFS=$'\t' read -r _ _ _ _ _ _ focus_target focus_hunk_header << EOF
${matched_row}
EOF
            focused_hunk_diff=$(printf "%s\n" "${file_diff}" | yen_git_review_extract_hunk_from_file_diff "${hunk_line}" || true)
            if [[ -z "${focused_hunk_diff}" ]]; then
                yen_error "Unable to isolate focused diff hunk for ${focus_target}."
                exit 1
            fi
            echo "Focused hunk: ${focus_target}"
            echo "Header:       ${focus_hunk_header}"
            echo ""
            yen_git_review_show_diff_text "${focused_hunk_diff}"
        else
            echo "Focused diff: ${selected_file}"
            echo ""
            yen_git_review_show_diff_text "${file_diff}"
        fi
    fi

    local evidence_file=""
    if [[ "${make_evidence}" == "1" ]]; then
        local timestamp
        timestamp=$(date -u +"%Y%m%dT%H%M%SZ")
        evidence_file="${IDE_EVIDENCE_DIR}/pr-${pr_number}-${timestamp}.md"
        write_pr_evidence_bundle \
            "${root}" "${pr_number}" "${pr_title}" "${pr_url}" "${pr_author}" "${pr_base}" "${pr_head}" \
            "${pr_changed}" "${pr_add}" "${pr_del}" "${files}" "${selected_file}" "${focus_target}" "${focus_hunk_header}" "${evidence_file}"
        yen_success "Wrote PR evidence bundle: ${evidence_file}"
        timeline_log "pr-evidence" "${root}" "pr=${pr_number}" "file=${selected_file};target=${focus_target};path=${evidence_file}"
    fi

    if [[ -n "${decision_mode}" ]]; then
        local timestamp_decision
        timestamp_decision=$(date -u +"%Y%m%dT%H%M%SZ")
        local decision_file="${IDE_EVIDENCE_DIR}/pr-${pr_number}-decision-${decision_mode}-${timestamp_decision}.md"
        write_pr_decision_template \
            "${decision_mode}" "${root}" "${pr_number}" "${pr_title}" "${pr_url}" "${selected_file}" "${focus_target}" "${evidence_file}" "${user_note}" "${decision_file}"
        yen_success "Wrote PR decision template: ${decision_file}"
        if [[ "${post_evidence}" == "1" ]]; then
            submit_pr_decision "${pr_number}" "${decision_mode}" "${decision_file}"
            yen_success "Posted ${decision_mode} review for PR #${pr_number}"
        fi
        timeline_log "pr-decision" "${root}" "pr=${pr_number};mode=${decision_mode}" "file=${selected_file};target=${focus_target};post=${post_evidence};artifact=${decision_file}"
    elif [[ "${post_evidence}" == "1" ]]; then
        if [[ -z "${evidence_file}" || ! -f "${evidence_file}" ]]; then
            if [[ -n "${inline_ref}" ]]; then
                :
            else
                yen_error "Evidence file missing; cannot post PR comment (use --evidence or --decision)."
                exit 1
            fi
        else
            gh pr comment "${pr_number}" --body-file "${evidence_file}"
            yen_success "Posted evidence comment to PR #${pr_number}"
        fi
    fi

    if [[ -n "${inline_ref}" ]]; then
        local timestamp_inline
        timestamp_inline=$(date -u +"%Y%m%dT%H%M%SZ")
        local inline_file="${IDE_EVIDENCE_DIR}/pr-${pr_number}-inline-${timestamp_inline}.md"
        {
            echo "Inline review comment for PR #${pr_number}"
            echo ""
            echo "- File: ${inline_path}"
            echo "- Line: ${inline_line}"
            echo "- Side: ${inline_side}"
            echo "- URL: ${pr_url}"
            echo ""
            if [[ -n "${inline_body}" ]]; then
                echo "${inline_body}"
            else
                echo "TODO: add inline comment text."
            fi
        } > "${inline_file}"
        yen_success "Wrote inline comment template: ${inline_file}"

        if [[ "${post_evidence}" == "1" ]]; then
            if [[ -z "${inline_body}" ]]; then
                yen_error "--post with --inline requires --inline-body (or --note)."
                exit 1
            fi
            submit_pr_inline_comment "${repo_slug}" "${pr_number}" "${pr_head_oid}" "${inline_path}" "${inline_line}" "${inline_side}" "${inline_file}"
            yen_success "Posted inline comment to PR #${pr_number} (${inline_path}:${inline_line}:${inline_side})"
            timeline_log "pr-inline-comment" "${root}" "pr=${pr_number};posted=yes" "path=${inline_path};line=${inline_line};side=${inline_side};artifact=${inline_file}"
        else
            timeline_log "pr-inline-comment" "${root}" "pr=${pr_number};posted=no" "path=${inline_path};line=${inline_line};side=${inline_side};artifact=${inline_file}"
        fi
    fi

    timeline_log "pr-review" "${root}" "pr=${pr_number}" "file=${selected_file};target=${focus_target};evidence=${make_evidence};post=${post_evidence}"
}

cmd_pr_notify() {
    local watch="0"
    local interval="120"
    local quiet="0"
    local ci_status="0"
    local max_notify="3"
    local max_polls=""
    local poll_count="0"
    local root=""
    local seen_file=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --watch)
                watch="1"
                ;;
            --once)
                watch="0"
                ;;
            --interval)
                shift
                interval="${1:-120}"
                ;;
            --quiet)
                quiet="1"
                ;;
            --ci-status)
                ci_status="1"
                ;;
            --max-notify)
                shift
                max_notify="${1:-3}"
                ;;
            --max-polls)
                shift
                max_polls="${1:-}"
                ;;
            *)
                yen_error "Unknown pr-notify option: $1"
                exit 1
                ;;
        esac
        shift
    done

    if ! ide_watch_validate_interval "${interval}"; then
        exit 1
    fi
    if [[ -n "${max_polls}" ]] && ! ide_watch_validate_max_runs "${max_polls}"; then
        exit 1
    fi
    if [[ "${watch}" != "1" && -n "${max_polls}" ]]; then
        yen_error "--max-polls requires --watch."
        exit 1
    fi

    if ! command -v gh >/dev/null 2>&1; then
        yen_error "GitHub CLI (gh) is required for pr-notify."
        exit 1
    fi

    root=$(find_project_root "${PWD}")
    seen_file=$(pr_seen_file "${root}")
    [[ -f "${seen_file}" ]] || : > "${seen_file}"

    while true; do
        poll_count=$((poll_count + 1))
        local repo
        repo=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
        if [[ -z "${repo}" ]]; then
            if [[ "${quiet}" != "1" ]]; then
                yen_warn "gh repo context unavailable. Run inside a GitHub repo with gh auth."
            fi
            return 1
        fi

        local rows
        rows=$(gh pr list \
            --search "review-requested:@me state:open" \
            --json number,title,url,updatedAt \
            --limit 50 \
            --jq '.[] | "\(.number)\t\(.title)\t\(.url)\t\(.updatedAt)"' 2>/dev/null || true)

        if [[ "${quiet}" != "1" ]]; then
            echo ""
            yen_header "PR Review Notifications"
            echo "Repo: ${repo}"
        fi

        if [[ -z "${rows}" ]]; then
            if [[ "${quiet}" != "1" ]]; then
                echo "No open PR review requests for @me."
                echo ""
            fi
        else
            local notify_count="0"
            if [[ "${quiet}" != "1" ]]; then
                printf "%-6s %-45s %s\n" "PR" "TITLE" "URL"
            fi

            while IFS=$'\t' read -r number title url updated; do
                [[ -z "${number}" ]] && continue
                if [[ "${quiet}" != "1" ]]; then
                    printf "#%-5s %-45s %s\n" "${number}" "$(printf "%s" "${title}" | cut -c1-45)" "${url}"
                fi

                local key="${repo}#${number}"
                if ! grep -Fxq -- "${key}" "${seen_file}" 2>/dev/null; then
                    if [[ "${notify_count}" -lt "${max_notify}" ]]; then
                        notify_local "YEN PR Review Requested" "${repo} #${number}: ${title}"
                        timeline_log "pr-notify" "${root}" "new=${number}" "repo=${repo};title=${title}"
                        notify_count=$((notify_count + 1))
                    fi
                    append_if_missing "${seen_file}" "${key}"
                fi
            done << EOF
${rows}
EOF
            if [[ "${quiet}" != "1" ]]; then
                echo ""
            fi
        fi

        if [[ "${ci_status}" == "1" ]]; then
            local ci_snapshot=""
            ci_snapshot=$(current_branch_ci_snapshot "${repo}")
            record_pr_ci_transition "${root}" "${ci_snapshot}"
            if [[ "${quiet}" != "1" ]]; then
                echo "Current Branch CI"
                echo "Repo: ${repo}"
                echo "Status: $(doctor_snapshot_value "${ci_snapshot}" "checks_state")"
                echo "Reason: $(doctor_snapshot_value "${ci_snapshot}" "reason")"
                if [[ "$(doctor_snapshot_value "${ci_snapshot}" "available")" == "yes" ]]; then
                    echo "PR: #$(doctor_snapshot_value "${ci_snapshot}" "pr_number") $(doctor_snapshot_value "${ci_snapshot}" "title")"
                    echo "Branch: $(doctor_snapshot_value "${ci_snapshot}" "branch")"
                    echo "Checks: pass=$(doctor_snapshot_value "${ci_snapshot}" "checks_passing") pending=$(doctor_snapshot_value "${ci_snapshot}" "checks_pending") fail=$(doctor_snapshot_value "${ci_snapshot}" "checks_failing") total=$(doctor_snapshot_value "${ci_snapshot}" "checks_total")"
                    if [[ -n "$(doctor_snapshot_value "${ci_snapshot}" "url")" ]]; then
                        echo "URL: $(doctor_snapshot_value "${ci_snapshot}" "url")"
                    fi
                fi
                render_local_build_watch_summary "${root}"
                echo ""
            fi
        fi

        [[ "${watch}" == "1" ]] || break
        if [[ -n "${max_polls}" && "${poll_count}" -ge "${max_polls}" ]]; then
            break
        fi
        sleep "${interval}"
    done
}

policy_mode_for_root() {
    local root="$1"
    local policy_file="${root}/.yen/policy.toml"
    local mode="prompt-high"
    if [[ -f "${policy_file}" ]]; then
        local parsed
        parsed=$(sed -nE 's/^[[:space:]]*(gate_mode|mode)[[:space:]]*=[[:space:]]*"([^"]+)".*/\2/p' "${policy_file}" | head -n 1)
        if [[ -n "${parsed}" ]]; then
            mode="${parsed}"
        fi
    fi
    printf "%s\n" "${mode}"
}

gate_allowlist_file_for_root() {
    local root="$1"
    printf "%s/.yen/gate-allowlist\n" "${root}"
}

command_matches_allowlist() {
    local command_text="$1"
    local allowlist_file="$2"
    [[ -f "${allowlist_file}" ]] || return 1

    local pattern=""
    while IFS= read -r pattern || [[ -n "${pattern}" ]]; do
        pattern=$(trim "${pattern}")
        [[ -z "${pattern}" ]] && continue
        [[ "${pattern#\#}" != "${pattern}" ]] && continue
        if printf "%s\n" "${command_text}" | grep -Eq -- "${pattern}"; then
            return 0
        fi
    done < "${allowlist_file}"
    return 1
}

classify_risk() {
    local command_text="$1"
    local allowlist_file="$2"
    local lower
    local score=0
    local reasons="baseline"
    local level="low"
    lower=$(printf "%s" "${command_text}" | tr '[:upper:]' '[:lower:]')

    if [[ -n "${allowlist_file}" ]] && command_matches_allowlist "${command_text}" "${allowlist_file}"; then
        printf "low|0|allowlisted-pattern\n"
        return 0
    fi

    if [[ "${lower}" == *"rm -rf"* ]] || [[ "${lower}" == *"rm -fr"* ]] || [[ "${lower}" == *"mkfs"* ]] || [[ "${lower}" == *"diskutil erase"* ]] || [[ "${lower}" == *":(){ :|:& };:"* ]]; then
        score=$((score + 95))
        reasons="${reasons},destructive-or-disk-command"
    fi
    if [[ "${lower}" == *"git reset --hard"* ]] || [[ "${lower}" == *"git clean -fdx"* ]] || [[ "${lower}" == *"git push --force"* ]] || [[ "${lower}" == *"chmod -r "* ]] || [[ "${lower}" == *"chown -r "* ]]; then
        score=$((score + 70))
        reasons="${reasons},history-or-permission-rewrite"
    fi
    if [[ "${lower}" == sudo* ]] || [[ "${lower}" == *" sudo "* ]]; then
        score=$((score + 60))
        reasons="${reasons},elevated-privilege"
    fi
    if [[ "${lower}" == *"curl "*'| sh'* ]] || [[ "${lower}" == *"curl "*'| bash'* ]] || [[ "${lower}" == *"wget "*'| sh'* ]] || [[ "${lower}" == *"wget "*'| bash'* ]]; then
        score=$((score + 75))
        reasons="${reasons},remote-script-execution"
    fi
    if [[ "${lower}" == *"git rebase"* ]] || [[ "${lower}" == *"git cherry-pick"* ]] || [[ "${lower}" == *"docker system prune"* ]] || [[ "${lower}" == *"npm publish"* ]] || [[ "${lower}" == *"bun publish"* ]] || [[ "${lower}" == *"pnpm publish"* ]] || [[ "${lower}" == *"yarn publish"* ]]; then
        score=$((score + 35))
        reasons="${reasons},state-mutating-command"
    fi
    if [[ "${lower}" == *"git push"* ]] || [[ "${lower}" == *"terraform apply"* ]] || [[ "${lower}" == *"kubectl delete"* ]]; then
        score=$((score + 30))
        reasons="${reasons},remote-or-cluster-impact"
    fi

    if [[ "${score}" -ge 85 ]]; then
        level="critical"
    elif [[ "${score}" -ge 55 ]]; then
        level="high"
    elif [[ "${score}" -ge 25 ]]; then
        level="medium"
    else
        level="low"
    fi

    printf "%s|%s|%s\n" "${level}" "${score}" "${reasons}"
}

needs_approval_for() {
    local policy_mode="$1"
    local risk_level="$2"
    case "${policy_mode}" in
        prompt-all)
            return 0
            ;;
        disabled|off|allow|none)
            return 1
            ;;
        prompt-medium|strict)
            [[ "${risk_level}" == "medium" || "${risk_level}" == "high" || "${risk_level}" == "critical" ]]
            return $?
            ;;
        prompt-high|auto|default)
            [[ "${risk_level}" == "high" || "${risk_level}" == "critical" ]]
            return $?
            ;;
        *)
            [[ "${risk_level}" == "high" || "${risk_level}" == "critical" ]]
            return $?
            ;;
    esac
}

detect_go_module_dirs() {
    local root="$1"
    find "${root}" -maxdepth 3 \
        \( -type d \( \
            -name .git -o \
            -name .hg -o \
            -name .svn -o \
            -name .next -o \
            -name .turbo -o \
            -name .venv -o \
            -name .yarn -o \
            -name .tmp -o \
            -name .temp -o \
            -name .scratch -o \
            -name DerivedData -o \
            -name __pycache__ -o \
            -name build -o \
            -name dist -o \
            -name ghostty -o \
            -name node_modules -o \
            -name scratch -o \
            -name 'scratch-*' -o \
            -name temp -o \
            -name 'temp-*' -o \
            -name tmp -o \
            -name 'tmp-*' -o \
            -name vendor -o \
            -name venv -o \
            -name zig-out \
        \) -prune \) -o \
        \( -type f -name go.mod -print \) 2>/dev/null | sed "s|/go.mod$||" | sort -u
}

has_package_script() {
    local root="$1"
    local script_name="$2"
    local pkg="${root}/package.json"
    [[ -f "${pkg}" ]] || return 1
    grep -q "\"${script_name}\"[[:space:]]*:" "${pkg}" 2>/dev/null
}

detect_node_package_manager() {
    local root="$1"
    if command -v bun >/dev/null 2>&1 && [[ -f "${root}/bun.lockb" || -f "${root}/bun.lock" ]]; then
        printf "bun\n"
        return 0
    fi
    if command -v pnpm >/dev/null 2>&1 && [[ -f "${root}/pnpm-lock.yaml" ]]; then
        printf "pnpm\n"
        return 0
    fi
    if command -v yarn >/dev/null 2>&1 && [[ -f "${root}/yarn.lock" ]]; then
        printf "yarn\n"
        return 0
    fi
    if command -v npm >/dev/null 2>&1; then
        printf "npm\n"
        return 0
    fi
    printf "none\n"
}

failing_step_ids_from_summary() {
    local summary_path="$1"
    [[ -f "${summary_path}" ]] || return 0
    awk -F'\t' 'NF >= 3 && $3 != "0" { print $2 }' "${summary_path}" 2>/dev/null | sort -u
}

cmd_gate() {
    local assume_yes="0"
    local dry_run="0"
    local policy_override=""
    local risk_override=""
    local allowlist_file_override=""
    local cmd_argv=()
    local root
    local policy_mode
    local allowlist_file=""
    local command_text=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes|-y)
                assume_yes="1"
                ;;
            --dry-run)
                dry_run="1"
                ;;
            --policy)
                shift
                policy_override="${1:-}"
                ;;
            --risk-override)
                shift
                risk_override="${1:-}"
                ;;
            --allowlist)
                shift
                allowlist_file_override="${1:-}"
                ;;
            --)
                shift
                cmd_argv=("$@")
                break
                ;;
            *)
                cmd_argv+=("$1")
                ;;
        esac
        shift
    done

    if [[ ${#cmd_argv[@]} -eq 0 ]]; then
        yen_error "gate requires a command. Example: yen ide gate -- git reset --hard"
        exit 1
    fi

    local part
    for part in "${cmd_argv[@]}"; do
        if [[ -n "${command_text}" ]]; then
            command_text="${command_text} "
        fi
        command_text="${command_text}${part}"
    done

    root=$(find_project_root "${PWD}")
    policy_mode=$(policy_mode_for_root "${root}")
    if [[ -n "${policy_override}" ]]; then
        policy_mode="${policy_override}"
    fi
    allowlist_file=$(gate_allowlist_file_for_root "${root}")
    if [[ -n "${allowlist_file_override}" ]]; then
        allowlist_file="${allowlist_file_override}"
    fi

    local risk_info
    local risk_level
    local risk_score
    local risk_reason
    risk_info=$(classify_risk "${command_text}" "${allowlist_file}")
    risk_level="${risk_info%%|*}"
    local rest="${risk_info#*|}"
    risk_score="${rest%%|*}"
    risk_reason="${rest#*|}"

    if [[ -n "${risk_override}" ]]; then
        risk_override=$(printf "%s" "${risk_override}" | tr '[:upper:]' '[:lower:]')
        case "${risk_override}" in
            low|medium|high|critical)
                risk_level="${risk_override}"
                risk_reason="${risk_reason},override=${risk_override}"
                ;;
            *)
                yen_error "Invalid --risk-override '${risk_override}'. Use low|medium|high|critical."
                exit 1
                ;;
        esac
    fi

    local needs_prompt="0"
    if needs_approval_for "${policy_mode}" "${risk_level}"; then
        needs_prompt="1"
    fi

    local approved="yes"
    if [[ "${needs_prompt}" == "1" && "${assume_yes}" != "1" ]]; then
        if [[ -t 0 ]]; then
            echo ""
            yen_header "IDE Approval Gate"
            echo "Policy:      ${policy_mode}"
            echo "Risk:        ${risk_level} (score=${risk_score}; ${risk_reason})"
            echo "Project:     ${root}"
            echo "Command:"
            echo "  ${command_text}"
            echo ""
            read -r -p "Approve command? [y/N] " gate_answer
            case "${gate_answer}" in
                y|Y|yes|YES)
                    approved="yes"
                    ;;
                *)
                    approved="no"
                    ;;
            esac
        else
            approved="no"
        fi
    fi

    if [[ "${approved}" != "yes" ]]; then
        timeline_log "gate" "${root}" "denied" "policy=${policy_mode};risk=${risk_level};score=${risk_score};reason=${risk_reason};cmd=${command_text}"
        yen_error "Command denied by approval gate."
        yen_info "If this is a false positive: use --risk-override low (or configure .yen/gate-allowlist)."
        exit 1
    fi

    timeline_log "gate" "${root}" "approved" "policy=${policy_mode};risk=${risk_level};score=${risk_score};reason=${risk_reason};cmd=${command_text}"

    if [[ "${dry_run}" == "1" ]]; then
        yen_info "Dry run: command approved (not executed)."
        echo "Gate summary: policy=${policy_mode} risk=${risk_level} score=${risk_score}"
        return 0
    fi

    set +e
    "${cmd_argv[@]}"
    local cmd_status=$?
    set -e
    timeline_log "gate-exec" "${root}" "status=${cmd_status}" "risk=${risk_level};score=${risk_score};cmd=${command_text}"
    return "${cmd_status}"
}

cmd_non_interference() {
    local subcommand="status"
    local window_days
    window_days=$(non_interference_default_window_days)

    if [[ $# -gt 0 ]]; then
        case "$1" in
            status|record|freeze|unfreeze)
                subcommand="$1"
                shift
                ;;
        esac
    fi

    case "${subcommand}" in
        status)
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --window-days)
                        shift
                        window_days="${1:-}"
                        ;;
                    *)
                        yen_error "Unknown non-interference status option: $1"
                        exit 1
                        ;;
                esac
                shift
            done

            if [[ ! "${window_days}" =~ ^[0-9]+$ ]] || [[ "${window_days}" -lt 1 ]]; then
                yen_error "Invalid --window-days '${window_days}'. Use a positive integer."
                exit 1
            fi

            ensure_state_dirs

            local summary
            local active
            local mode
            local total
            local breaches
            local ratio
            local budget
            local min_samples
            local cutoff_epoch
            local rows=""
            local freeze_label="inactive"
            local freeze_reason=""
            local freeze_at=""

            summary=$(evaluate_non_interference_budget "${window_days}" "0")
            IFS='|' read -r active mode total breaches ratio budget min_samples << EOF
${summary}
EOF

            cutoff_epoch=$(( $(date +%s) - (window_days * 86400) ))
            rows=$(awk -F'\t' -v cutoff="${cutoff_epoch}" '
                NF >= 6 && $2 ~ /^[0-9]+$/ && $2 >= cutoff {
                    metric = $3
                    total[metric] += 1
                    if ($6 == "breach") {
                        breach[metric] += 1
                    }
                    latest_value[metric] = $4
                    threshold[metric] = $5
                    latest_ts[metric] = $1
                }
                END {
                    for (metric in total) {
                        b = breach[metric] + 0
                        rate = (total[metric] > 0) ? ((b / total[metric]) * 100.0) : 0
                        printf "%s\t%d\t%d\t%.2f\t%s\t%s\t%s\n", metric, total[metric], b, rate, latest_value[metric], threshold[metric], latest_ts[metric]
                    }
                }
            ' "${IDE_NON_INTERFERENCE_SLO_FILE}" 2>/dev/null | sort || true)

            if [[ "${active}" == "1" ]]; then
                freeze_label="active"
            fi

            if [[ -f "${IDE_NON_INTERFERENCE_FREEZE_FILE}" ]]; then
                freeze_reason=$(non_interference_freeze_field "reason" 2>/dev/null || true)
                freeze_at=$(non_interference_freeze_field "activated_at" 2>/dev/null || true)
            fi

            echo ""
            yen_header "Non-Interference Guardrails"
            echo "Window: ${window_days} day(s)"
            echo "Error budget: ${budget} (minimum samples: ${min_samples})"
            echo "Samples: ${total} | Breaches: ${breaches} | Breach ratio: ${ratio}"
            echo "Feature freeze: ${freeze_label} (mode=${mode})"
            if [[ -n "${freeze_reason}" ]]; then
                echo "Freeze reason: ${freeze_reason}"
            fi
            if [[ -n "${freeze_at}" ]]; then
                echo "Freeze activated: ${freeze_at}"
            fi

            if [[ -z "${rows}" ]]; then
                echo "No SLO samples in the selected window."
                echo ""
                return 0
            fi

            echo ""
            printf "%-28s %-7s %-8s %-10s %-10s %-10s %s\n" "METRIC" "SAMPLES" "BREACH" "RATE(%)" "LATEST" "THRESHOLD" "LAST_SEEN"
            while IFS=$'\t' read -r metric m_total m_breach m_rate latest threshold last_ts; do
                [[ -z "${metric}" ]] && continue
                printf "%-28s %-7s %-8s %-10s %-10s %-10s %s\n" "${metric}" "${m_total}" "${m_breach}" "${m_rate}" "${latest}" "${threshold}" "${last_ts}"
            done << EOF
${rows}
EOF
            echo ""
            ;;
        record)
            local metric=""
            local raw_metric=""
            local value=""
            local threshold=""
            local source_name="manual"
            local project_path=""
            local root=""
            local sample_status="pass"
            local now_epoch
            local now_iso
            local was_frozen="0"
            local summary=""
            local active=""
            local mode=""
            local total=""
            local breaches=""
            local ratio=""
            local budget=""
            local min_samples=""
            local source_sanitized=""
            local threshold_sanitized=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --metric)
                        shift
                        raw_metric="${1:-}"
                        ;;
                    --value)
                        shift
                        value="${1:-}"
                        ;;
                    --source)
                        shift
                        source_name="${1:-manual}"
                        ;;
                    --project)
                        shift
                        project_path="${1:-}"
                        ;;
                    --window-days)
                        shift
                        window_days="${1:-}"
                        ;;
                    *)
                        yen_error "Unknown non-interference record option: $1"
                        exit 1
                        ;;
                esac
                shift
            done

            if [[ -z "${raw_metric}" ]]; then
                yen_error "record requires --metric <name>."
                exit 1
            fi
            if [[ -z "${value}" ]]; then
                yen_error "record requires --value <number>."
                exit 1
            fi
            if ! is_number_value "${value}"; then
                yen_error "Invalid --value '${value}'. Must be numeric."
                exit 1
            fi
            if [[ ! "${window_days}" =~ ^[0-9]+$ ]] || [[ "${window_days}" -lt 1 ]]; then
                yen_error "Invalid --window-days '${window_days}'. Use a positive integer."
                exit 1
            fi

            metric=$(normalize_non_interference_metric "${raw_metric}" || true)
            if [[ -z "${metric}" ]]; then
                yen_error "Unknown metric '${raw_metric}'. Use key-to-echo-p95-ms|key-to-echo-p99-ms|search-latency-ms|lsp-start-ms|verify-duration-ms|orchestration-latency-ms|startup-regression-ms|idle-cpu-overhead-pct|idle-extra-rss-mib."
                exit 1
            fi

            threshold=$(non_interference_metric_threshold "${metric}" || true)
            if [[ -z "${threshold}" ]] || ! is_number_value "${threshold}"; then
                yen_error "Metric threshold for '${metric}' is not configured as numeric."
                exit 1
            fi
            if float_gt "${value}" "${threshold}"; then
                sample_status="breach"
            fi

            ensure_state_dirs
            root=$(find_project_root "${project_path}")
            now_epoch=$(date +%s)
            now_iso=$(iso_now)
            source_sanitized=$(printf "%s" "${source_name}" | tr '\t\r\n' '   ')
            threshold_sanitized=$(printf "%s" "${threshold}" | tr '\t\r\n' ' ')

            if [[ -f "${IDE_NON_INTERFERENCE_FREEZE_FILE}" ]]; then
                was_frozen="1"
            fi

            printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
                "${now_iso}" "${now_epoch}" "${metric}" "${value}" "${threshold_sanitized}" "${sample_status}" "${source_sanitized}" "${root}" >> "${IDE_NON_INTERFERENCE_SLO_FILE}"

            timeline_log "non-interference-slo" "${root}" "${sample_status}" "metric=${metric};value=${value};threshold=${threshold};source=${source_sanitized}"

            summary=$(evaluate_non_interference_budget "${window_days}" "1")
            IFS='|' read -r active mode total breaches ratio budget min_samples << EOF
${summary}
EOF

            if [[ "${active}" == "1" && "${was_frozen}" != "1" ]]; then
                timeline_log "non-interference-freeze" "${root}" "active" "mode=${mode};window_days=${window_days};ratio=${ratio};budget=${budget};samples=${total};breaches=${breaches}"
            fi
            if [[ "${active}" != "1" && "${was_frozen}" == "1" ]]; then
                timeline_log "non-interference-freeze" "${root}" "cleared" "mode=${mode};window_days=${window_days};ratio=${ratio};budget=${budget};samples=${total};breaches=${breaches}"
            fi

            if [[ "${sample_status}" == "breach" ]]; then
                yen_warn "Recorded SLO breach (${metric}=${value}, threshold=${threshold})."
            else
                yen_info "Recorded SLO sample (${metric}=${value}, threshold=${threshold})."
            fi
            echo "Feature freeze: $([[ "${active}" == "1" ]] && echo "active" || echo "inactive") (mode=${mode})"
            ;;
        freeze)
            local reason="manual-operator-override"
            local root=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --reason)
                        shift
                        reason="${1:-manual-operator-override}"
                        ;;
                    --project)
                        shift
                        root=$(find_project_root "${1:-}")
                        ;;
                    *)
                        yen_error "Unknown non-interference freeze option: $1"
                        exit 1
                        ;;
                esac
                shift
            done
            ensure_state_dirs
            if [[ -z "${root}" ]]; then
                root=$(find_project_root "")
            fi
            reason=$(printf "%s" "${reason}" | tr '\t\r\n' '   ')
            write_non_interference_manual_freeze "${reason}"
            timeline_log "non-interference-freeze" "${root}" "active" "mode=manual;reason=${reason}"
            yen_warn "Manual non-interference freeze enabled."
            ;;
        unfreeze)
            local root=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --project)
                        shift
                        root=$(find_project_root "${1:-}")
                        ;;
                    *)
                        yen_error "Unknown non-interference unfreeze option: $1"
                        exit 1
                        ;;
                esac
                shift
            done
            ensure_state_dirs
            if [[ -z "${root}" ]]; then
                root=$(find_project_root "")
            fi
            rm -f "${IDE_NON_INTERFERENCE_FREEZE_FILE}"
            timeline_log "non-interference-freeze" "${root}" "cleared" "mode=manual;reason=operator-unfreeze"
            yen_info "Non-interference freeze cleared."
            ;;
        *)
            yen_error "Unknown non-interference command: ${subcommand}"
            exit 1
            ;;
    esac
}

cmd_timeline() {
