        workflow|workflows)
            shift
            cmd_workflow "$@"
            ;;
        timeline)
            shift
            cmd_timeline "$@"
            ;;
        non-interference|noninterference|slo)
            shift
            cmd_non_interference "$@"
            ;;
        *)
            yen_error "Unknown ide command: $1"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
