    latest_verify=$(latest_verify_summary_for_root "${root}" || true)
    local latest_verify_status_section=""
    latest_verify_status_section=$(render_verify_status_markdown_section_for_root "${root}" || true)
    local evidence_status_section=""
    local evidence_status_timeline=""
    local original_timeline_file="${IDE_TIMELINE_FILE}"
    local timeline_tail=""
    timeline_tail=$(tail -n 120 "${IDE_TIMELINE_FILE}" 2>/dev/null | awk -F'\t' -v root="${root}" '$3 == root' | tail -n 20)
    local review_context_json=""
    local review_markdown=""
    local agent_notes_markdown=""
    local -a review_targets=()
    local file_line=""

    if declare -F review_context_json_for_targets >/dev/null 2>&1; then
        if [[ -n "${focus_target}" ]]; then
            review_targets+=("${focus_target}")
        elif [[ -n "${selected_file}" ]]; then
            review_targets+=("${selected_file}")
        fi
        if [[ ${#review_targets[@]} -eq 0 ]]; then
            while IFS= read -r file_line; do
                [[ -n "${file_line}" ]] && review_targets+=("${file_line}")
                [[ ${#review_targets[@]} -ge 6 ]] && break
            done << EOF
${files}
EOF
        fi
        if [[ ${#review_targets[@]} -gt 0 ]]; then
            review_context_json=$(review_context_json_for_targets "${root}" "${review_targets[@]}")
            review_markdown=$(review_context_markdown_section_from_json "${review_context_json}" "Review Routing" "6" || true)
