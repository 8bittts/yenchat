IDE_WORKFLOW_TRUST_FILE="${IDE_STATE_DIR}/trusted-workflow-projects"
IDE_LSP_TRUST_FILE="${IDE_STATE_DIR}/trusted-lsp-projects"
IDE_DEVCONTAINER_TRUST_FILE="${IDE_STATE_DIR}/trusted-devcontainer-projects"
IDE_SHARE_TRUST_FILE="${IDE_STATE_DIR}/trusted-share-projects"
IDE_DEBUG_TRUST_FILE="${IDE_STATE_DIR}/trusted-debug-projects"
IDE_MODULE_DIR="${YEN_LIB}/ide"

# Module load order is part of the router contract. Extracted modules must stay
# source-time pure and define their exported helpers/handlers before the
# assertions below run, so loader drift fails fast during startup.
declare -a _IDE_LOADED_MODULES=()

_ide_module_loaded() {
    local module="$1"
    local loaded=""
    for loaded in "${_IDE_LOADED_MODULES[@]}"; do
        if [[ "${loaded}" == "${module}" ]]; then
            return 0
        fi
    done
    return 1
}

ide_require_module() {
    local module="$1"
    local module_path=""

    if _ide_module_loaded "${module}"; then
        return 0
    fi

    module_path="${IDE_MODULE_DIR}/${module}.sh"
    if [[ ! -f "${module_path}" ]]; then
        yen_error "IDE module not found: ${module}"
        exit 1
    fi

    # shellcheck source=/dev/null
    source "${module_path}"
    _IDE_LOADED_MODULES+=("${module}")
}

ide_require_module_list() {
    local module=""
    for module in "$@"; do
        ide_require_module "${module}"
    done
}

ide_require_phase1_modules() {
    ide_require_module "bootstrap"
    ide_bootstrap_assert_compatible "1"
}

