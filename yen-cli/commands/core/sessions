#!/bin/bash
# YEN sessions command: list, attach to, and end persistent pane sessions.
#
# A persistent pane runs inside the bundled zmx; its session is named by the pane
# UUID and lives in ~/.local/state/yen/zmx. Each session is attached and ended with
# the zmx build recorded in <id>.zmx, because an update can ship a zmx with another
# protocol (_docs/01-architecture.md -> Persistent sessions).
# --host reaches another Mac's sessions over ssh (lib/sessions-remote.sh).

source "${YEN_LIB}/init.sh"

SESSIONS_DIR="${YEN_SESSIONS_DIR:-$HOME/.local/state/yen/zmx}"
ZMX_BIN="${YEN_RESOURCES}/bin/zmx"
DEV_ZMX_BIN="${YEN_RESOURCES}/../yen-terminal/customizations/vendor/zmx/zmx"
UUID_PATTERN='^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'

source "${YEN_LIB}/sessions-remote.sh"

usage() {
    cat << 'EOF'
Usage:
  yen sessions                              List persistent pane sessions
  yen sessions list [--porcelain]           Same as above
  yen sessions list --host <host>           List the sessions of another Mac
  yen sessions attach <id>                  Attach this terminal to a session
  yen sessions attach --host <host> <id>    Attach to a session on another Mac
  yen sessions kill <id>                    End a session and the processes in it

Options:
  --porcelain     Stable tab-separated output for scripts
  --host <host>   [user@]host to reach with ssh; YEN must be installed there

Notes:
  A session keeps a pane's shell running when YEN quits; reopening the window
  reattaches it. "detached" means no pane shows the session right now.
  Attach from another terminal or over SSH to reach a session without its window.
  attach --host reconnects after a dropped link until it reattaches, the session
  ends or you press Ctrl-C. kill only ends sessions on this Mac.

Exit codes for --host:
  10 cannot reach the host       11 the host needs a first ssh connection
  12 YEN is not installed there  13 YEN there is too old for remote sessions
  14 no such session there       15 the host key changed
EOF
}

usage_error() {
    echo "yen sessions: $1" >&2
    echo "Run 'yen sessions --help' for usage." >&2
    exit 2
}

resolve_zmx() {
    if [[ -x "$ZMX_BIN" ]]; then
        echo "$ZMX_BIN"
        return 0
    fi
    if [[ -x "$DEV_ZMX_BIN" ]]; then
        echo "$DEV_ZMX_BIN"
        return 0
    fi
    return 1
}

# The build that created a session, or the current build for a session without a record.
session_zmx() {
    local id="$1" recorded=""
    if [[ -f "${SESSIONS_DIR}/${id}.zmx" ]]; then
        recorded="$(head -n 1 "${SESSIONS_DIR}/${id}.zmx")"
    fi
    if [[ "$recorded" == /* && -x "$recorded" ]]; then
        echo "$recorded"
        return 0
    fi
    resolve_zmx
}

require_session() {
    local id="$1"
    [[ "$id" =~ $UUID_PATTERN ]] || usage_error "'$id' is not a session id (run 'yen sessions' to list them)"
    [[ -S "${SESSIONS_DIR}/${id}" ]] || {
        echo "yen sessions: no session $id" >&2
        exit 1
    }
}

# Print a listing directory for people: ~ for home.
display_directory() {
    local path="$1"
    # The ~ is display text for the listing, not a path to expand.
    # shellcheck disable=SC2088
    if [[ "$path" == "$HOME" ]]; then
        path="~"
    elif [[ "$path" == "$HOME/"* ]]; then
        path="~/${path#"$HOME"/}"
    fi
    printf '%s' "$path"
}

# Turn porcelain rows (header first) into the human table. A remote listing
# keeps absolute paths, because ~ would mean this Mac's home.
print_porcelain_table() {
    local where="${1:-local}" header id state started directory count=0
    IFS= read -r header || return 0
    while IFS=$'\t' read -r id state started directory; do
        if [[ $count -eq 0 ]]; then
            printf '%-36s  %-11s  %-16s  %s\n' "ID" "STATE" "STARTED" "DIRECTORY"
        fi
        if [[ "$started" =~ ^[0-9]+$ ]]; then
            started="$(date -r "$started" '+%Y-%m-%d %H:%M' 2>/dev/null || echo -)"
        fi
        [[ $where == remote ]] || directory="$(display_directory "$directory")"
        printf '%-36s  %-11s  %-16s  %s\n' "$id" "$state" "$started" "$directory"
        count=$((count + 1))
    done
    [[ $count -gt 0 ]] || echo "No persistent sessions."
}

# zmx reports cwd as a file:// or kitty-shell-cwd:// URL; return the path.
directory_path() {
    local url="$1" path
    [[ "$url" == *://* ]] || { printf '%s' "$url"; return 0; }
    path="${url#*://}"
    printf '/%s' "${path#*/}"
}

# Porcelain rows without the header, one per pane session.
list_sessions() {
    local status=0 zmx listing line field key value name clients created cwd state
    [[ -d "$SESSIONS_DIR" ]] || return 0
    zmx="$(resolve_zmx)" || {
        yen_error "zmx is not available; reinstall YEN."
        exit 1
    }
    listing="$(/bin/bash "$YEN_LIB/list-pane-sessions.sh" "$SESSIONS_DIR" "$zmx")" || status=$?
    if [[ $status -ne 0 ]]; then
        yen_error "Could not list persistent sessions."
        [[ $status -eq 2 && -n "$listing" ]] || return 1
    fi
    while IFS= read -r line; do
        [[ "$line" == *name=* ]] || continue
        name="" clients="" created="" cwd="" state=""
        line="${line#*name=}"
        line="name=${line}"
        while IFS= read -r -d $'\t' field || [[ -n "$field" ]]; do
            key="${field%%=*}"
            value="${field#*=}"
            case "$key" in
                name) name="$value" ;;
                clients) clients="$value" ;;
                created) created="$value" ;;
                cwd) cwd="$value" ;;
                err) state="unreachable" ;;
            esac
        done <<< "$line"
        [[ "$name" =~ $UUID_PATTERN ]] || continue
        if [[ -z "$state" ]]; then
            if [[ "$clients" == "0" ]]; then state="detached"; else state="attached"; fi
        fi
        [[ "$created" =~ ^[0-9]{1,12}$ ]] || created="-"
        porcelain_row "$name" "$state" "$created" "$(directory_path "${cwd:--}")"
    done <<< "$listing"
    return "$status"
}

# Local listing in either format. The table is rendered from the porcelain rows,
# so the two never disagree.
show_sessions() {
    local porcelain="$1" status=0 rows
    rows="$(list_sessions)" || status=$?
    if [[ $porcelain == 1 ]]; then
        printf '%s\n' "$PORCELAIN_HEADER${rows:+$'\n'$rows}"
    elif [[ -n "$rows" || $status -eq 0 ]]; then
        # A failed listing with no rows must not claim there are no sessions.
        print_porcelain_table <<< "$PORCELAIN_HEADER${rows:+$'\n'$rows}"
    fi
    return "$status"
}

# Parse --host and --porcelain for list and attach; the rest are positional.
host="" porcelain=0 positional=()
parse_options() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --host)
                [[ $# -ge 2 ]] || usage_error "--host needs a host"
                [[ -z "$host" ]] || usage_error "--host given twice"
                valid_remote_target "$2" || usage_error "'$2' is not a host name or address"
                host="$2"
                shift 2
                ;;
            --porcelain) porcelain=1; shift ;;
            --) shift; positional+=("$@"); return 0 ;;
            -*) usage_error "unknown option '$1'" ;;
            *) positional+=("$1"); shift ;;
        esac
    done
}

subcommand="${1:-list}"
[[ $# -eq 0 ]] || shift
case "$subcommand" in
    list | ls)
        parse_options "$@"
        [[ ${#positional[@]} -eq 0 ]] || usage_error "list takes no arguments"
        [[ -z "$host" ]] || remote_list "$host" "$porcelain"
        show_sessions "$porcelain"
        ;;
    attach)
        parse_options "$@"
        [[ $porcelain == 0 ]] || usage_error "attach does not take --porcelain"
        [[ ${#positional[@]} -eq 1 ]] || usage_error "attach needs exactly one session id"
        id="${positional[0]}"
        if [[ -n "$host" ]]; then
            [[ "$id" =~ $UUID_PATTERN ]] || usage_error "'$id' is not a session id (run 'yen sessions list --host $host' to list them)"
            remote_attach "$host" "$id"
        fi
        require_session "$id"
        zmx="$(session_zmx "$id")" || { yen_error "zmx is not available; reinstall YEN."; exit 1; }
        ZMX_DIR="$SESSIONS_DIR" exec "$zmx" attach "$id"
        ;;
    kill)
        # Ending a session stays local: a remote session ends from a pane attached to it.
        [[ $# -eq 1 ]] || usage_error "kill needs exactly one session id"
        require_session "$1"
        zmx="$(session_zmx "$1")" || { yen_error "zmx is not available; reinstall YEN."; exit 1; }
        if ZMX_DIR="$SESSIONS_DIR" "$zmx" kill "$1" >/dev/null 2>&1; then
            rm -f "${SESSIONS_DIR}/${1}.tty" "${SESSIONS_DIR}/${1}.zmx" "${SESSIONS_DIR}/${1}.owner"
            echo "Ended session $1"
        else
            echo "yen sessions: could not end session $1" >&2
            exit 1
        fi
        ;;
    -h | --help | help)
        usage
        ;;
    *)
        usage_error "unknown subcommand '$subcommand'"
        ;;
esac
