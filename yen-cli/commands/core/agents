agents_find_latest_session_for_workspace_slot() {
    local workspace_identity="$1"
    local project_root="$2"
    local slot_id="$3"
    python3 - "${AGENTS_SESSION_STATE_DIR}" "${AGENTS_TIMELINE_FILE}" "${workspace_identity}" "${project_root}" "${slot_id}" <<'PY'
import os
import sys
from pathlib import Path

session_dir, timeline_path, workspace_identity, project_root, slot_id = sys.argv[1:6]
best = None


def parse_kv_lines(path):
    payload = {}
    try:
        with open(path, "r", encoding="utf-8") as handle:
            for raw in handle:
                line = raw.rstrip("\n")
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                payload[key] = value
    except OSError:
        return {}
    return payload


def parse_detail(detail):
    payload = {}
    for item in detail.split(";"):
        item = item.strip()
        if not item or "=" not in item:
            continue
        key, value = item.split("=", 1)
        payload[key] = value
    return payload


def workspace_matches(payload_workspace, payload_project):
    if payload_workspace:
        return payload_workspace in {workspace_identity, project_root}
    if payload_project:
        return payload_project == project_root
    return False


for path in sorted(Path(session_dir).glob("*.state")):
    payload = parse_kv_lines(path)
    if not workspace_matches(payload.get("workspace_identity", ""), payload.get("project_root", "")):
        continue
    if payload.get("slot_id", "") != slot_id:
        continue
    try:
        mtime_key = int(os.path.getmtime(path) * 1_000_000)
    except OSError:
        mtime_key = 0
    rank = (
        payload.get("started_at", ""),
        payload.get("stopped_at", ""),
        mtime_key,
        path.stem,
    )
    if best is None or rank > best[0]:
        best = (rank, path.stem)

if best is None and timeline_path and os.path.exists(timeline_path):
    try:
        with open(timeline_path, "r", encoding="utf-8") as handle:
            for line_number, raw in enumerate(handle):
                parts = raw.rstrip("\n").split("\t", 4)
                if len(parts) < 5:
                    continue
                timestamp, event, root_key, _status, detail_text = parts
                if root_key != project_root:
                    continue
                if event not in {"session-start", "session-stop"}:
                    continue
                detail = parse_detail(detail_text)
                if detail.get("slot", "") != slot_id:
                    continue
                if not workspace_matches(detail.get("workspace_identity", ""), root_key):
                    continue
                session_id = detail.get("session", "")
                if not session_id:
                    continue
                rank = (
                    detail.get("started_at", "") or timestamp,
                    detail.get("stopped_at", "") or timestamp,
                    line_number,
                    session_id,
                )
                if best is None or rank > best[0]:
                    best = (rank, session_id)
    except OSError:
        pass

print(best[1] if best else "")
PY
}

agents_session_metadata_for_id() {
    local session_id="$1"
    local project_root="$2"
    local workspace_identity="$3"
    local state_file=""

    state_file=$(session_state_file "${session_id}")
    if [[ -f "${state_file}" ]]; then
        cat "${state_file}"
        return 0
    fi

    python3 - "${AGENTS_TIMELINE_FILE}" "${session_id}" "${project_root}" "${workspace_identity}" <<'PY'
import os
import sys

timeline_path, session_id, project_root, workspace_identity = sys.argv[1:5]
best = None


def parse_detail(detail):
    payload = {}
    for item in detail.split(";"):
        item = item.strip()
        if not item or "=" not in item:
            continue
        key, value = item.split("=", 1)
        payload[key] = value
    return payload


def workspace_matches(payload_workspace, payload_project):
    if payload_workspace:
        return payload_workspace in {workspace_identity, project_root}
    if payload_project:
        return payload_project == project_root
    return False


if timeline_path and os.path.exists(timeline_path):
    try:
        with open(timeline_path, "r", encoding="utf-8") as handle:
            for line_number, raw in enumerate(handle):
                parts = raw.rstrip("\n").split("\t", 4)
                if len(parts) < 5:
                    continue
                timestamp, event, root_key, _status, detail_text = parts
                if root_key != project_root:
                    continue
                if event not in {"session-start", "session-stop"}:
                    continue
                detail = parse_detail(detail_text)
                if detail.get("session", "") != session_id:
                    continue
                if not workspace_matches(detail.get("workspace_identity", ""), root_key):
                    continue
                rank = (
                    detail.get("started_at", "") or timestamp,
                    detail.get("stopped_at", "") or timestamp,
                    line_number,
                )
                payload = {
                    "session_id": session_id,
                    "slot_id": detail.get("slot", ""),
                    "adapter": detail.get("adapter", ""),
                    "workspace_identity": detail.get("workspace_identity", "") or project_root,
                    "project_root": project_root,
                    "branch": detail.get("branch", ""),
                    "dirty_state": detail.get("dirty", ""),
                    "launch_mode": detail.get("launch_mode", ""),
                }
                if best is None or rank > best[0]:
                    best = (rank, payload)
    except OSError:
        pass

if best is not None:
    for key, value in best[1].items():
        print(f"{key}={value}")
PY
}

agents_note_template_defaults() {
    local template_name="$1"
    case "${template_name}" in
        review-approved)
            printf "approval|approved|Approved for review|Manual review completed; ready for the next review or merge step.\n"
            ;;
        review-rejected)
            printf "approval|rejected|Changes required before review|Manual review found follow-up work before the next review or merge step.\n"
            ;;
        handoff-review)
            printf "handoff||Review handoff|Handing off the current workspace state for review.\n"
            ;;
        handoff-merge)
            printf "handoff||Merge handoff|Handing off the current workspace state for merge-readiness or ship review.\n"
            ;;
        *)
            return 1
            ;;
    esac
}

agents_note_display_text() {
    printf "%s" "$1" | tr '\t\r\n' '   ' | sed 's/;/,/g;s/^[[:space:]]*//;s/[[:space:]]*$//'
}

agents_note_default_title() {
    local kind="$1"
    local decision="$2"
    local message="$3"
    local preview=""

    preview=$(agents_note_display_text "$(printf "%s" "${message}" | head -n 1)")
    if [[ -n "${preview}" && ${#preview} -gt 72 ]]; then
        preview="${preview:0:69}..."
    fi

    case "${kind}" in
        approval)
            case "${decision}" in
                approved)
                    printf "Approved\n"
                    return 0
                    ;;
                rejected)
                    printf "Changes required\n"
                    return 0
                    ;;
                *)
                    printf "Approval note\n"
                    return 0
                    ;;
            esac
            ;;
        handoff)
            printf "Handoff\n"
            return 0
            ;;
    esac

    if [[ -n "${preview}" ]]; then
        printf "%s\n" "${preview}"
        return 0
    fi
    printf "Note\n"
}

agents_timeline_log() {
    local event="$1"
    local project_root="$2"
    local status="$3"
    local detail="$4"
    detail=$(printf "%s" "${detail}" | tr '\t\r\n' '   ')
    printf "%s\t%s\t%s\t%s\t%s\n" "$(agents_iso_now)" "${event}" "${project_root}" "${status}" "${detail}" >> "${AGENTS_TIMELINE_FILE}"
}

agents_timeline_log_best_effort() {
    agents_timeline_log "$@" 2>/dev/null || true
}

