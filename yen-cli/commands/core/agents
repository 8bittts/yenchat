def event_source_kind(source_tag):
    if source_tag.startswith("agent:"):
        return "agent"
    if source_tag in {"human", "supervisor", "system"}:
        return source_tag
    return "system"


def event_family_and_action(event):
    mapping = {
        "session-start": ("session", "start"),
        "session-stop": ("session", "stop"),
        "template-apply": ("template", "apply"),
        "note": ("note", "record"),
        "export": ("artifact", "export"),
    }
    return mapping.get(event, ("system", event))


def event_outcome(event, status, detail, status_fields):
    if event == "session-start":
        return status or "started"
    if event == "session-stop":
        return status_fields.get("status", "stopped")
    if event == "note":
        if status.startswith("approval="):
            return status.split("=", 1)[1]
        return detail.get("decision") or detail.get("kind") or status or "recorded"
    if event == "template-apply":
        return status or "applied"
    if event == "export":
        return "exported"
    return status or "recorded"


def event_target(detail, session_id, note_id):
    slot_id = detail.get("slot", "")
    template_name = detail.get("template", "")
    if note_id:
        target_kind = "note"
        label = note_id
    elif template_name:
        target_kind = "template"
        label = template_name
    elif slot_id:
        target_kind = "slot"
        label = slot_id
    elif session_id:
        target_kind = "session"
        label = session_id
    else:
        target_kind = "workspace"
        label = ""

    return {
        "kind": target_kind,
        "label": label,
        "sessionId": session_id,
        "slotId": slot_id,
        "templateName": template_name,
        "noteId": note_id,
    }


def read_session_state(session_id):
    if not session_id:
        return None
    path = os.path.join(session_dir, f"{session_id}.state")
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as handle:
            return parse_kv_lines(handle.read())
    return timeline_session_states().get(session_id)


def read_note_payload(note_id):
    if not note_id:
        return None
    state_path = os.path.join(note_dir, f"{note_id}.state")
    message_path = os.path.join(note_dir, f"{note_id}.txt")
    if not os.path.exists(state_path):
        return None
    with open(state_path, "r", encoding="utf-8") as handle:
        payload = parse_kv_lines(handle.read())
    message = ""
    if os.path.exists(message_path):
        with open(message_path, "r", encoding="utf-8") as handle:
            message = handle.read()
    return {
        "noteId": payload.get("note_id", note_id),
        "actor": payload.get("actor", ""),
        "kind": payload.get("kind", ""),
        "decision": payload.get("decision", ""),
        "template": payload.get("template", ""),
        "title": payload.get("title", ""),
        "linkValidated": payload.get("link_validated", "") == "yes",
        "workspaceIdentity": payload.get("workspace_identity", ""),
        "projectRoot": payload.get("project_root", ""),
        "sessionId": payload.get("session_id", ""),
        "slotId": payload.get("slot_id", ""),
        "createdAt": payload.get("created_at", ""),
        "message": message,
    }


def event_source_tag(event, detail):
    if event == "note":
        actor = detail.get("actor", "")
        return actor or "human"
    if event in {"session-start", "session-stop"}:
        slot = detail.get("slot", "")
        adapter = detail.get("adapter", "")
        if slot:
            return f"agent:{slot}"
        if adapter:
            return f"agent:{adapter}"
    return "system"


def normalize_event(time, event, root_key, status, detail_text):
    detail = parse_detail(detail_text)
    session_id = detail.get("session", "")
    note_id = detail.get("note_id", "")
    source_tag = event_source_tag(event, detail)
    source_kind = event_source_kind(source_tag)
    status_fields = parse_detail(status)
    family, action = event_family_and_action(event)
    outcome = event_outcome(event, status, detail, status_fields)
    row = {
        "schemaVersion": 1,
        "time": time,
        "timestamp": time,
        "event": event,
        "eventName": event,
        "eventFamily": family,
        "eventAction": action,
        "eventOutcome": outcome,
        "projectRoot": root_key,
        "status": status,
        "statusFields": status_fields,
        "detail": detail_text,
        "detailFields": detail,
        "sessionId": session_id,
        "noteId": note_id,
        "slotId": detail.get("slot", ""),
        "templateName": detail.get("template", ""),
        "adapter": detail.get("adapter", ""),
        "branch": detail.get("branch", ""),
        "dirtyState": detail.get("dirty", ""),
        "launchMode": detail.get("launch_mode", ""),
        "workspaceIdentity": detail.get("workspace_identity", workspace_identity),
        "source": {
            "tag": source_tag,
            "kind": source_kind,
            "actor": detail.get("actor", ""),
            "slotId": detail.get("slot", ""),
            "adapter": detail.get("adapter", ""),
        },
        "target": event_target(detail, session_id, note_id),
    }
    session_state = read_session_state(session_id)
    if session_state is not None:
        row["sessionState"] = session_state_with_schema(session_state)
    note_payload = read_note_payload(note_id)
    if note_payload is not None:
        row["note"] = note_payload_with_schema(note_payload)
    row["sourceTag"] = source_tag
    return row


def read_events():
    rows = []
    if not os.path.exists(filtered_file):
        return rows
    with open(filtered_file, "r", encoding="utf-8") as handle:
        for raw in handle:
            raw = raw.rstrip("\n")
            if not raw:
                continue
            parts = raw.split("\t", 4)
            if len(parts) < 5:
                continue
            rows.append(normalize_event(*parts))
    return rows


def read_adapters():
    rows = []
    if not os.path.exists(adapter_file):
        return rows
    with open(adapter_file, "r", encoding="utf-8") as handle:
        for raw in handle:
            raw = raw.rstrip("\n")
            if not raw:
                continue
            parts = raw.split("\t")
            if len(parts) < 7:
                continue
            (
                name,
                binary_name,
                binary_path,
                probe_command,
                status,
                version,
                capabilities,
            ) = parts[:7]
            rows.append(
                {
