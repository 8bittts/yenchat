write_agents_session_state() {
    local session_id="$1"
    local slot_id="$2"
    local adapter="$3"
    local workspace_identity="$4"
    local project_root="$5"
    local branch="$6"
    local dirty_state="$7"
    local launch_mode="$8"
    local lifecycle_state="$9"
    local started_at="${10}"
    local stopped_at="${11}"
    local exit_code="${12}"
    local binary_name="${13}"
    local binary_path="${14}"
    local probe_cmd="${15}"
    local probe_status="${16}"
    local probe_version="${17}"
    local declared_capabilities="${18}"
    local launch_result="${19}"
