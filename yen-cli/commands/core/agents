                    "capabilitiesList": [item for item in capabilities.split(",") if item],
                }
            )
    return rows


def session_sort_key(row):
    return (
        row.get("startedAt", ""),
        row.get("stoppedAt", ""),
        int(row.get("_mtimeNs", 0) or 0),
        row.get("sessionId", ""),
    )


def summarize_grouped_sessions(grouped):
    summaries = {}
    for adapter_name, sessions in grouped.items():
        session_rows = list(sessions.values())
        session_rows.sort(key=session_sort_key)
        summaries[adapter_name] = {
            "sessionCount": len(session_rows),
            "latestSession": session_rows[-1] if session_rows else None,
        }
    return summaries


