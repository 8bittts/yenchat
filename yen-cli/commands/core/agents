}

resolve_adapter_binary_path() {
    local binary_name="$1"
    command -v "${binary_name}" 2>/dev/null | head -n 1
}

agents_redact_file_to_stdout() {
    local path="$1"
    python3 - "${path}" <<'PY'
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8")

patterns = [
    (
        re.compile(r'(?i)\b(authorization\s*[:=]\s*bearer\s+)([^\s"\'`,;]+)'),
        lambda match: f"{match.group(1)}[REDACTED:bearer-token]",
    ),
    (
        re.compile(r'(?i)\b(password|passwd|token|secret|api[_-]?key|access[_-]?key|refresh[_-]?token|session[_-]?token)\b(\s*[:=]\s*)([^\s,"\';]+)'),
        lambda match: f"{match.group(1)}{match.group(2)}[REDACTED:secret]",
    ),
    (
        re.compile(r'\bghp_[A-Za-z0-9]{20,}\b'),
        lambda match: "[REDACTED:github-token]",
    ),
    (
        re.compile(r'\bgithub_pat_[A-Za-z0-9_]{20,}\b'),
        lambda match: "[REDACTED:github-token]",
    ),
    (
        re.compile(r'\bsk-(?:proj-)?[A-Za-z0-9_-]{20,}\b'),
        lambda match: "[REDACTED:api-key]",
    ),
    (
        re.compile(r'\bAIza[0-9A-Za-z\-_]{35}\b'),
        lambda match: "[REDACTED:api-key]",
    ),
    (
        re.compile(r'\bAKIA[0-9A-Z]{16}\b'),
        lambda match: "[REDACTED:aws-access-key]",
    ),
    (
        re.compile(r'\bxox[baprs]-[A-Za-z0-9-]{10,}\b'),
        lambda match: "[REDACTED:slack-token]",
    ),
]

for pattern, replacer in patterns:
    text = pattern.sub(replacer, text)

sys.stdout.write(text)
PY
}

agents_redact_text_best_effort() {
    local input="$1"
    local output=""
    local temp_file=""
    temp_file=$(mktemp)
    printf "%s" "${input}" > "${temp_file}"
    if output=$(agents_redact_file_to_stdout "${temp_file}" 2>/dev/null); then
        rm -f "${temp_file}"
        printf "%s" "${output}"
        return 0
    fi
    rm -f "${temp_file}"
    printf "%s" "${input}"
}

agents_redact_file_in_place_best_effort() {
    local path="$1"
    local temp_file=""
    [[ -f "${path}" ]] || return 0

    temp_file=$(mktemp)
    if agents_redact_file_to_stdout "${path}" > "${temp_file}" 2>/dev/null; then
        mv "${temp_file}" "${path}"
        return 0
    fi
    rm -f "${temp_file}"
    return 0
}

agents_prune_retention() {
    local retention_days="${AGENTS_RETENTION_DAYS:-7}"
    if [[ ! "${retention_days}" =~ ^[0-9]+$ ]]; then
        retention_days="7"
    fi
    if [[ "${retention_days}" -lt 1 ]]; then
        retention_days="7"
    fi

    AGENTS_SESSION_STATE_DIR="${AGENTS_SESSION_STATE_DIR}" \
    AGENTS_NOTE_STATE_DIR="${AGENTS_NOTE_STATE_DIR}" \
    AGENTS_EXPORT_DIR="${AGENTS_EXPORT_DIR}" \
    AGENTS_TIMELINE_FILE="${AGENTS_TIMELINE_FILE}" \
    AGENTS_ARCHIVE_DIR="${AGENTS_ARCHIVE_DIR}" \
    AGENTS_RETENTION_DAYS="${retention_days}" \
    python3 - <<'PY'
import os
import shutil
from datetime import datetime, timedelta, timezone
from pathlib import Path

retention_days = int(os.environ.get("AGENTS_RETENTION_DAYS", "7") or "7")
archive_root = os.environ.get("AGENTS_ARCHIVE_DIR", "").strip()
session_dir = Path(os.environ["AGENTS_SESSION_STATE_DIR"])
note_dir = Path(os.environ["AGENTS_NOTE_STATE_DIR"])
export_dir = Path(os.environ["AGENTS_EXPORT_DIR"])
timeline_path = Path(os.environ["AGENTS_TIMELINE_FILE"])

cutoff = datetime.now(timezone.utc) - timedelta(days=retention_days)
archive_base = Path(archive_root) if archive_root else None


def archive_or_delete(path: Path, subdir: str):
    if archive_base is not None:
        target_dir = archive_base / subdir
        target_dir.mkdir(parents=True, exist_ok=True)
        target = target_dir / path.name
        if target.exists():
            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            target = target_dir / f"{path.name}.{stamp}"
        shutil.move(str(path), str(target))
    else:
        try:
            path.unlink()
        except FileNotFoundError:
            return


def prune_dir(root: Path, pattern: str, subdir: str):
    if not root.exists():
        return
    for path in root.glob(pattern):
        try:
            modified = datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
        except FileNotFoundError:
            continue
        if modified < cutoff:
            archive_or_delete(path, subdir)


def parse_iso8601(value: str):
    try:
        return datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def append_archived_timeline(lines):
    if archive_base is None or not lines:
        return
    target_dir = archive_base / "timeline"
    target_dir.mkdir(parents=True, exist_ok=True)
    target = target_dir / "timeline.log"
    with open(target, "a", encoding="utf-8") as handle:
        if target.exists() and target.stat().st_size > 0:
            handle.write("\n")
        handle.write("\n".join(lines))


prune_dir(session_dir, "*.state", "sessions")
prune_dir(note_dir, "*.state", "notes")
prune_dir(note_dir, "*.txt", "notes")
prune_dir(export_dir, "*", "exports")

if timeline_path.exists():
    keep = []
    expired = []
    with open(timeline_path, "r", encoding="utf-8") as handle:
        for raw in handle:
            line = raw.rstrip("\n")
            if not line:
                continue
            timestamp = parse_iso8601(line.split("\t", 1)[0])
            if timestamp is None or timestamp >= cutoff:
                keep.append(line)
            else:
                expired.append(line)
    append_archived_timeline(expired)
    with open(timeline_path, "w", encoding="utf-8") as handle:
        if keep:
            handle.write("\n".join(keep))
            handle.write("\n")
PY
}

agents_prune_retention_best_effort() {
