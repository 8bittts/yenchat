find_adapter_row() {
    local name="$1"
    local row=""
    while IFS= read -r row; do
        [[ -z "${row}" ]] && continue
        local adapter_name=""
        IFS=$'\t' read -r adapter_name _ << EOF
${row}
EOF
        if [[ "${adapter_name}" == "${name}" ]]; then
            printf "%s\n" "${row}"
            return 0
        fi
    done << EOF
$(adapter_catalog)
EOF
    return 1
}

probe_adapter_status() {
    local binary_name="$1"
    local probe_cmd="$2"
    local status="missing"
    local version="-"

    if ! command -v "${binary_name}" >/dev/null 2>&1; then
        printf "%s|%s\n" "${status}" "${version}"
        return 0
    fi

    local probe_output=""
    local probe_status=0
    set +e
    probe_output=$(eval "${probe_cmd}" 2>/dev/null | head -n 1)
    probe_status=$?
    set -e

    if [[ "${probe_status}" -eq 0 ]]; then
        status="ready"
        if [[ -n "${probe_output}" ]]; then
            version="${probe_output}"
        else
            version="unknown"
        fi
    else
        status="probe-failed"
        version="exit=${probe_status}"
    fi

    printf "%s|%s\n" "${status}" "${version}"
}

parse_workspace_template_file() {
    local path="$1"
    local fallback_name="$2"
    local name=""
    local description=""
    local slots=""
    local schema_version=""
    local source="project"

    [[ -f "${path}" ]] || return 1

    name=$(sed -nE 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "${path}" | head -n 1)
    description=$(sed -nE 's/^[[:space:]]*description[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "${path}" | head -n 1)
    slots=$(sed -nE 's/^[[:space:]]*slots[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "${path}" | head -n 1)
    schema_version=$(sed -nE 's/^[[:space:]]*schema_version[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p' "${path}" | head -n 1)

    if [[ -z "${name}" ]]; then
        name="${fallback_name}"
    fi
    if [[ -z "${description}" ]]; then
        description="Workspace template from ${path}"
    fi
    if [[ -z "${schema_version}" ]]; then
        yen_error "Workspace template '${path}' is missing required 'schema_version'."
        return 2
    fi
    if [[ "${schema_version}" != "1" ]]; then
        yen_error "Workspace template '${path}' has unsupported schema_version='${schema_version}'. Expected '1'."
        return 2
    fi
    if [[ -z "${slots}" ]]; then
        yen_error "Workspace template '${path}' is missing required 'slots'."
        return 2
    fi

    printf "%s\t%s\t%s\t%s\t%s\n" "${name}" "${description}" "${slots}" "${schema_version}" "${source}"
}

find_workspace_template() {
    local root="$1"
    local template_name="$2"
    local project_file="${root}/.yen/workspaces/${template_name}.toml"
    local row=""

    if [[ -f "${project_file}" ]]; then
        parse_workspace_template_file "${project_file}" "${template_name}"
        return $?
    fi

    while IFS= read -r row; do
        [[ -z "${row}" ]] && continue
        local name=""
        IFS=$'\t' read -r name _ << EOF
${row}
EOF
        if [[ "${name}" == "${template_name}" ]]; then
            printf "%s\n" "${row}"
            return 0
        fi
    done << EOF
$(workspace_builtin_catalog)
EOF
    return 1
}

print_workspace_plan_rows() {
    local slots_csv="$1"
    local rows_file="$2"
    local token=""

    : > "${rows_file}"
    while IFS= read -r token; do
        token=$(trim "${token}")
        [[ -z "${token}" ]] && continue

        if [[ "${token}" == "supervisor" ]]; then
            printf "%s\t%s\t%s\n" "${token}" "ready" "reserved supervisor slot" >> "${rows_file}"
            continue
        fi

        local adapter_row=""
        adapter_row=$(find_adapter_row "${token}" || true)
        if [[ -z "${adapter_row}" ]]; then
            printf "%s\t%s\t%s\n" "${token}" "degraded" "unknown slot/adapter" >> "${rows_file}"
            continue
        fi

        local _name=""
        local binary_name=""
        local _probe=""
        local _caps=""
        IFS=$'\t' read -r _name binary_name _probe _caps << EOF
${adapter_row}
EOF
        if command -v "${binary_name}" >/dev/null 2>&1; then
            printf "%s\t%s\t%s\n" "${token}" "ready" "adapter binary available" >> "${rows_file}"
        else
            printf "%s\t%s\t%s\n" "${token}" "degraded" "binary '${binary_name}' not found" >> "${rows_file}"
        fi
    done << EOF
$(printf "%s" "${slots_csv}" | tr ',' '\n')
EOF
}

apply_workspace_template() {
    local root="$1"
    local template_name="$2"
    local dry_run="$3"
    local from_open="$4"

    local row=""
    local name=""
    local description=""
    local slots=""
    local schema_version=""
    local source=""
    local signature=""
    local state_file=""
    local current_signature=""
    local plan_file=""
    local degraded_count=0
    local ready_count=0
    local slot=""
    local status=""
    local detail=""
    local workspace_identity=""
    local timeline_status="applied"

    row=$(find_workspace_template "${root}" "${template_name}" || true)
    if [[ -z "${row}" ]]; then
        yen_error "Unknown workspace template '${template_name}'. Run: yen agents templates list"
        return 1
    fi

    IFS=$'\t' read -r name description slots schema_version source << EOF
${row}
EOF

    workspace_identity=$(agents_workspace_identity_for_root "${root}")
    signature="${schema_version}|${slots}"
    state_file=$(workspace_state_file "${root}" "${name}")
    plan_file=$(mktemp)
    print_workspace_plan_rows "${slots}" "${plan_file}"

    while IFS=$'\t' read -r slot status detail; do
        [[ -z "${slot}" ]] && continue
        if [[ "${status}" == "degraded" ]]; then
            degraded_count=$((degraded_count + 1))
        else
            ready_count=$((ready_count + 1))
        fi
    done < "${plan_file}"

    if [[ -f "${state_file}" ]]; then
        current_signature=$(sed -nE 's/^template_signature=(.*)$/\1/p' "${state_file}" | head -n 1)
    fi

    echo ""
    yen_header "Workspace Template"
    echo "Project:      ${root}"
    echo "Template:     ${name}"
    echo "Schema:       ${schema_version}"
    echo "Source:       ${source}"
    echo "Description:  ${description}"
    echo ""
    printf "%-14s %-10s %s\n" "SLOT" "STATUS" "DETAIL"
    while IFS=$'\t' read -r slot status detail; do
        [[ -z "${slot}" ]] && continue
        printf "%-14s %-10s %s\n" "${slot}" "${status}" "${detail}"
    done < "${plan_file}"
    echo ""

    if [[ "${dry_run}" == "1" ]]; then
        yen_info "Dry run: template plan rendered with no side effects."
        if [[ "${degraded_count}" -gt 0 ]]; then
            yen_warn "Plan is degraded (${degraded_count} slot(s) not materialized). Run: yen agents list"
        fi
        rm -f "${plan_file}"
        return 0
    fi

    if [[ "${current_signature}" == "${signature}" ]]; then
        yen_info "Workspace template '${name}' already applied (idempotent)."
        agents_timeline_log_best_effort "template-apply" "${root}" "unchanged" "template=${name};source=${source};schema=${schema_version};slots=${slots};ready=${ready_count};degraded=${degraded_count};workspace_identity=${workspace_identity}"
        rm -f "${plan_file}"
        return 0
    fi

    cat > "${state_file}" << EOF
template_name=${name}
template_signature=${signature}
schema_version=${schema_version}
slots=${slots}
source=${source}
applied_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
project_root=${root}
EOF

    yen_success "Applied workspace template '${name}'."
    if [[ "${degraded_count}" -gt 0 ]]; then
        timeline_status="degraded"
        yen_warn "Applied in degraded mode (${degraded_count} slot(s) unresolved)."
        yen_info "Run: yen agents list"
    fi

    agents_timeline_log_best_effort "template-apply" "${root}" "${timeline_status}" "template=${name};source=${source};schema=${schema_version};slots=${slots};ready=${ready_count};degraded=${degraded_count};workspace_identity=${workspace_identity}"

    if [[ "${from_open}" == "1" ]]; then
        if [[ "${ready_count}" -eq 0 ]]; then
            yen_warn "No ready adapter slots were found for this template."
        else
            yen_info "Template applied. Open each ready slot in separate tabs/splits with:"
            while IFS=$'\t' read -r slot status detail; do
                [[ -z "${slot}" ]] && continue
                if [[ "${status}" == "ready" && "${slot}" != "supervisor" ]]; then
                    echo "  - yen agents open ${slot}"
                fi
            done < "${plan_file}"
        fi
    fi

    rm -f "${plan_file}"
    return 0
}

