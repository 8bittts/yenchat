cmd_note() {
    local actor="human"
    local kind="note"
    local kind_explicit="0"
    local decision=""
    local decision_explicit="0"
    local template_name=""
    local title=""
    local validate_link="0"
    local link_validated="no"
    local project_target=""
    local session_id=""
    local slot_id=""
    local message=""
    local template_row=""
    local template_kind=""
    local template_decision=""
    local template_title=""
    local template_message=""
    local root=""
    local workspace_identity=""
    local note_id=""
    local created_at=""
    local status_label="note"
    local session_metadata=""

    if [[ $# -eq 0 ]]; then
        note_help
        return 0
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help|help)
                note_help
                return 0
                ;;
            --actor)
                shift
                actor="${1:-}"
                ;;
            --kind)
                shift
                kind="${1:-}"
                kind_explicit="1"
                ;;
            --decision)
                shift
                decision="${1:-}"
                decision_explicit="1"
                ;;
            --template)
                shift
                template_name="${1:-}"
                ;;
            --title)
                shift
                title="${1:-}"
                ;;
            --validate-link)
                validate_link="1"
                ;;
            --project|--path)
                shift
                project_target="${1:-}"
                ;;
            --session)
                shift
                session_id="${1:-}"
                ;;
            --slot)
                shift
                slot_id="${1:-}"
                ;;
            --message)
                shift
                message="${1:-}"
                ;;
            *)
                yen_error "Unknown note option: $1"
                exit 1
                ;;
        esac
        shift
    done

    if [[ "${message}" == "-" ]]; then
        message=$(cat)
    fi

    if [[ -n "${template_name}" ]]; then
        template_row=$(agents_note_template_defaults "${template_name}" || true)
        if [[ -z "${template_row}" ]]; then
            yen_error "Unknown note template: ${template_name}."
            exit 1
        fi
        IFS='|' read -r template_kind template_decision template_title template_message << EOF
${template_row}
EOF
        if [[ "${kind_explicit}" == "1" && "${kind}" != "${template_kind}" ]]; then
            yen_error "Template '${template_name}' requires --kind ${template_kind}."
            exit 1
        fi
        if [[ "${decision_explicit}" == "1" && -n "${template_decision}" && "${decision}" != "${template_decision}" ]]; then
            yen_error "Template '${template_name}' requires --decision ${template_decision}."
            exit 1
        fi
        kind="${template_kind}"
        [[ -z "${decision}" ]] && decision="${template_decision}"
        [[ -z "${title}" ]] && title="${template_title}"
        [[ -z "${message}" ]] && message="${template_message}"
    fi

    message=$(agents_redact_text_best_effort "${message}")
    title=$(agents_redact_text_best_effort "${title}")
    message=$(trim "${message}")
    title=$(agents_note_display_text "$(trim "${title}")")

    if [[ -z "${message}" ]]; then
        yen_error "note requires --message TEXT unless --template supplies a default."
        exit 1
    fi

    case "${actor}" in
        human|supervisor)
            ;;
        *)
            yen_error "note supports --actor human|supervisor."
            exit 1
            ;;
    esac

    case "${kind}" in
        note|approval|handoff)
            ;;
        *)
            yen_error "note supports --kind note|approval|handoff."
            exit 1
            ;;
    esac

    if [[ -n "${decision}" ]]; then
        case "${decision}" in
            approved|rejected|comment)
                ;;
            *)
                yen_error "note supports --decision approved|rejected|comment."
                exit 1
                ;;
        esac
    fi

    if [[ -n "${decision}" && "${kind}" != "approval" ]]; then
        yen_error "--decision is only valid with --kind approval."
        exit 1
    fi

    title=$(trim "${title}")
    if [[ -z "${title}" ]]; then
        title=$(agents_note_default_title "${kind}" "${decision}" "${message}")
    fi

    root=$(find_project_root "${project_target}")
    workspace_identity=$(agents_workspace_identity_for_root "${root}")
    note_id=$(generate_agents_note_id)
    created_at=$(agents_iso_now)

    if [[ -n "${session_id}" ]]; then
        session_metadata=$(agents_session_metadata_for_id "${session_id}" "${root}" "${workspace_identity}")
        if [[ -z "${session_metadata}" ]]; then
            yen_error "Unknown session '${session_id}'."
            exit 1
        fi
    fi

    if [[ -n "${session_id}" && -z "${slot_id}" ]]; then
        slot_id=$(printf "%s\n" "${session_metadata}" | sed -nE 's/^slot_id=(.*)$/\1/p' | head -n 1)
    fi

    if [[ "${validate_link}" == "1" ]]; then
        if [[ -n "${session_id}" ]]; then
            local session_workspace=""
            local session_slot=""
            session_workspace=$(printf "%s\n" "${session_metadata}" | sed -nE 's/^workspace_identity=(.*)$/\1/p' | head -n 1)
            session_slot=$(printf "%s\n" "${session_metadata}" | sed -nE 's/^slot_id=(.*)$/\1/p' | head -n 1)
            if [[ -n "${session_workspace}" && "${session_workspace}" != "${workspace_identity}" && "${session_workspace}" != "${root}" ]]; then
                yen_error "Session '${session_id}' belongs to a different workspace."
                exit 1
            fi
            if [[ -n "${slot_id}" && -n "${session_slot}" && "${slot_id}" != "${session_slot}" ]]; then
                yen_error "Session '${session_id}' is linked to slot '${session_slot}', not '${slot_id}'."
                exit 1
            fi
            [[ -z "${slot_id}" ]] && slot_id="${session_slot}"
            link_validated="yes"
        elif [[ -n "${slot_id}" ]]; then
            session_id=$(agents_find_latest_session_for_workspace_slot "${workspace_identity}" "${root}" "${slot_id}")
            if [[ -z "${session_id}" ]]; then
                yen_error "No known session for slot '${slot_id}' in this workspace."
                exit 1
            fi
            session_metadata=$(agents_session_metadata_for_id "${session_id}" "${root}" "${workspace_identity}")
            link_validated="yes"
        fi
    fi

    if [[ "${kind}" == "approval" ]]; then
        [[ -z "${decision}" ]] && decision="comment"
        status_label="approval=${decision}"
    else
        status_label="${kind}"
    fi

    write_agents_note_files "${note_id}" "${actor}" "${kind}" "${decision}" "${template_name}" "${title}" "${link_validated}" "${workspace_identity}" "${root}" "${session_id}" "${slot_id}" "${created_at}" "${message}"
    agents_timeline_log "note" "${root}" "${status_label}" "note_id=${note_id};actor=${actor};kind=${kind};decision=${decision};template=${template_name};link_validated=${link_validated};session=${session_id};slot=${slot_id};workspace_identity=${workspace_identity}"

    if [[ -t 1 ]]; then
        yen_success "Recorded agent note: ${note_id}"
    else
        printf '%s\n' "Recorded agent note: ${note_id}"
    fi
}

