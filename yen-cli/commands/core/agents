#!/bin/bash
# YEN Agents Command
# Multi-agent adapter board with first-party claude/codex profiles and workspace templates.

source "${YEN_LIB}/init.sh"

if [[ -f "${YEN_LIB}/ide/workspace-identity.sh" ]]; then
    source "${YEN_LIB}/ide/workspace-identity.sh"
fi

if [[ -f "${YEN_LIB}/ide/reports.sh" ]]; then
    source "${YEN_LIB}/ide/reports.sh"
fi

AGENTS_STATE_DIR="${YEN_AGENTS_STATE_DIR:-$HOME/.config/yen/agents}"
AGENTS_WORKSPACE_STATE_DIR="${AGENTS_STATE_DIR}/workspaces"
AGENTS_SESSION_STATE_DIR="${AGENTS_STATE_DIR}/sessions"
AGENTS_NOTE_STATE_DIR="${AGENTS_STATE_DIR}/notes"
AGENTS_EXPORT_DIR="${AGENTS_STATE_DIR}/exports"
AGENTS_TIMELINE_FILE="${AGENTS_STATE_DIR}/timeline.log"
AGENTS_RETENTION_DAYS="${YEN_AGENTS_RETENTION_DAYS:-7}"
AGENTS_ARCHIVE_DIR="${YEN_AGENTS_ARCHIVE_DIR:-}"
IDE_STATE_DIR="${YEN_IDE_STATE_DIR:-$HOME/.config/yen/ide}"
IDE_TIMELINE_FILE="${IDE_STATE_DIR}/timeline.log"

ensure_agents_state_dirs() {
    mkdir -p "${AGENTS_WORKSPACE_STATE_DIR}" "${AGENTS_SESSION_STATE_DIR}" "${AGENTS_NOTE_STATE_DIR}" "${AGENTS_EXPORT_DIR}"
    agents_prune_retention_best_effort
}

trim() {
    printf "%s" "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

find_project_root() {
    local start="${1:-$PWD}"
    local path="${start}"

    if [[ ! -d "${path}" ]]; then
        path="$(dirname "${path}")"
    fi
    path=$(cd "${path}" 2>/dev/null && pwd -P || printf "%s" "${start}")

    while true; do
        if [[ -e "${path}/.git" ]] || [[ -f "${path}/package.json" ]] || [[ -f "${path}/go.mod" ]] || [[ -f "${path}/Cargo.toml" ]] || [[ -d "${path}/.yen" ]]; then
            printf "%s\n" "${path}"
            return 0
        fi
        if [[ "${path}" == "/" ]]; then
            printf "%s\n" "${start}"
            return 0
        fi
        path="$(dirname "${path}")"
    done
}

project_hash() {
    local root="$1"
    if command -v shasum >/dev/null 2>&1; then
        printf "%s" "${root}" | shasum -a 256 | awk '{print $1}'
        return 0
    fi
    if command -v openssl >/dev/null 2>&1; then
        printf "%s" "${root}" | openssl dgst -sha256 | awk '{print $2}'
        return 0
    fi
    if command -v md5 >/dev/null 2>&1; then
        md5 -q -s "${root}"
        return 0
    fi
    printf "%s\n" "${root}" | tr -cd '[:alnum:]' | cut -c1-32
}

workspace_state_file() {
    local root="$1"
    local template_name="$2"
    local hash
    hash=$(project_hash "${root}")
    printf "%s/%s-%s.state\n" "${AGENTS_WORKSPACE_STATE_DIR}" "${hash}" "${template_name}"
}

agents_short_hash_for_root() {
    project_hash "$1" | cut -c1-12
}

agents_iso_now() {
    date -u +"%Y-%m-%dT%H:%M:%SZ"
}

agents_workspace_identity_for_root() {
    local root="$1"
    local identity=""
    if declare -F workspace_identity_build_local_identity >/dev/null 2>&1; then
        identity=$(workspace_identity_build_local_identity "${root}" 2>/dev/null || true)
        if [[ -n "${identity}" ]]; then
            printf "%s\n" "${identity}"
            return 0
        fi
    fi
    printf "%s\n" "${root}"
}

agents_git_branch_for_root() {
    local root="$1"
    local branch=""

    if [[ ! -d "${root}/.git" ]] && [[ ! -f "${root}/.git" ]]; then
        printf -- "-\n"
        return 0
    fi

    branch=$(git -C "${root}" symbolic-ref --quiet --short HEAD 2>/dev/null | head -n 1)
    if [[ -n "${branch}" ]]; then
        printf "%s\n" "${branch}"
        return 0
    fi

    branch=$(git -C "${root}" rev-parse --short HEAD 2>/dev/null | head -n 1)
    if [[ -n "${branch}" ]]; then
        printf "detached@%s\n" "${branch}"
        return 0
    fi

    printf -- "-\n"
}

agents_git_dirty_state_for_root() {
    local root="$1"

    if [[ ! -d "${root}/.git" ]] && [[ ! -f "${root}/.git" ]]; then
        printf "not-git\n"
        return 0
    fi

    if [[ -n "$(git -C "${root}" status --porcelain --untracked-files=normal 2>/dev/null)" ]]; then
        printf "dirty\n"
    else
        printf "clean\n"
    fi
}

generate_agents_session_id() {
    local stamp=""
    local nonce=""
    stamp=$(date -u +"%Y%m%dT%H%M%SZ")
    nonce=$(printf "%06d" $(( RANDOM % 1000000 )))
    printf "agt-%s-%s-%s\n" "${stamp}" "$$" "${nonce}"
}

generate_agents_export_suffix() {
    local stamp=""
    local nonce=""
    stamp=$(date -u +"%Y%m%dT%H%M%SZ")
    nonce=$(printf "%06d" $(( RANDOM % 1000000 )))
    printf "%s-%s\n" "${stamp}" "${nonce}"
}

generate_agents_note_id() {
    local stamp=""
    local nonce=""
    stamp=$(date -u +"%Y%m%dT%H%M%SZ")
    nonce=$(printf "%06d" $(( RANDOM % 1000000 )))
    printf "agn-%s-%s-%s\n" "${stamp}" "$$" "${nonce}"
}

session_state_file() {
    local session_id="$1"
    printf "%s/%s.state\n" "${AGENTS_SESSION_STATE_DIR}" "${session_id}"
}

session_state_value() {
    local session_id="$1"
    local key="$2"
    local state_file=""
    state_file=$(session_state_file "${session_id}")
    [[ -f "${state_file}" ]] || return 0
    sed -nE "s/^${key}=(.*)$/\\1/p" "${state_file}" | head -n 1
}

note_state_file() {
