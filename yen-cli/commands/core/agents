agents_render_snapshot_summary() {
    local snapshot="$1"
    local prefix="$2"
    local status=""
    local last_run=""
    local semantic=""
    local failures=""
    local warns=""
    local summary=""
    local extras=""

    status=$(agents_snapshot_value "${snapshot}" "${prefix}_status")
    last_run=$(agents_snapshot_value "${snapshot}" "${prefix}_last_run_at")
    semantic=$(agents_snapshot_value "${snapshot}" "${prefix}_semantic")
    failures=$(agents_snapshot_value "${snapshot}" "${prefix}_failures")
    warns=$(agents_snapshot_value "${snapshot}" "${prefix}_warns")
    summary=$(agents_snapshot_value "${snapshot}" "${prefix}_summary")

    [[ -z "${status}" ]] && status="never-run"
    [[ -z "${failures}" ]] && failures="0"
    [[ -z "${warns}" ]] && warns="0"

    if [[ "${status}" == "never-run" ]]; then
        printf "never-run\n"
        return 0
    fi

    extras="failures=${failures};warns=${warns}"
    if [[ -n "${semantic}" ]]; then
        extras="${extras};semantic=${semantic}"
    fi
    if [[ -n "${last_run}" ]]; then
        extras="${extras};last=${last_run}"
    fi
    if [[ -n "${summary}" ]]; then
        extras="${extras};summary=${summary}"
    fi

    printf "%s (%s)\n" "${status}" "${extras}"
}

