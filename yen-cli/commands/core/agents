def event_source_kind(source_tag):
    if source_tag.startswith("agent:"):
        return "agent"
    if source_tag in {"human", "supervisor", "system"}:
        return source_tag
    return "system"


def event_family_and_action(event):
    mapping = {
        "session-start": ("session", "start"),
        "session-stop": ("session", "stop"),
        "template-apply": ("template", "apply"),
        "note": ("note", "record"),
        "export": ("artifact", "export"),
    }
    return mapping.get(event, ("system", event))


def event_outcome(event, status, detail, status_fields):
    if event == "session-start":
        return status or "started"
    if event == "session-stop":
        return status_fields.get("status", "stopped")
    if event == "note":
        if status.startswith("approval="):
            return status.split("=", 1)[1]
        return detail.get("decision") or detail.get("kind") or status or "recorded"
    if event == "template-apply":
        return status or "applied"
    if event == "export":
        return "exported"
    return status or "recorded"


def event_target(detail, session_id, note_id):
    slot_id = detail.get("slot", "")
    template_name = detail.get("template", "")
    if note_id:
        target_kind = "note"
        label = note_id
    elif template_name:
        target_kind = "template"
        label = template_name
    elif slot_id:
        target_kind = "slot"
        label = slot_id
    elif session_id:
        target_kind = "session"
        label = session_id
    else:
        target_kind = "workspace"
        label = ""

    return {
        "kind": target_kind,
        "label": label,
        "sessionId": session_id,
        "slotId": slot_id,
        "templateName": template_name,
        "noteId": note_id,
    }


def read_session_state(session_id):
    if not session_id:
        return None
    path = os.path.join(session_dir, f"{session_id}.state")
    if os.path.exists(path):
