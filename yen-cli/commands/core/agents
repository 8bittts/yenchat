def git_repo_exists(path):
    return os.path.isdir(os.path.join(path, ".git")) or os.path.isfile(os.path.join(path, ".git"))


def git_command(path, *args):
    return subprocess.run(
        ["git", "-C", path, *args],
        capture_output=True,
        text=True,
        check=False,
    )


def parse_status_line(line):
    if len(line) < 3:
        return None
    xy = line[:2]
    path_text = line[3:]
    previous_path = ""
    if " -> " in path_text:
        previous_path, path_text = path_text.split(" -> ", 1)
    return {
        "xy": xy,
        "path": path_text,
        "previousPath": previous_path,
    }


def build_git_snapshot(path):
    if not git_repo_exists(path):
        return {
            "tracked": False,
            "head": "",
            "shortHead": "",
            "changedCounts": {},
            "changedFiles": [],
        }

    head = ""
    short_head = ""
    head_proc = git_command(path, "rev-parse", "HEAD")
    if head_proc.returncode == 0:
        head = head_proc.stdout.strip()
    short_proc = git_command(path, "rev-parse", "--short", "HEAD")
    if short_proc.returncode == 0:
        short_head = short_proc.stdout.strip()

    status_proc = git_command(path, "status", "--porcelain=1", "--untracked-files=all")
    changed_files = []
    counts = {
        "modified": 0,
        "added": 0,
        "deleted": 0,
        "renamed": 0,
        "untracked": 0,
        "other": 0,
    }
    for raw in status_proc.stdout.splitlines():
        parsed = parse_status_line(raw)
        if parsed is None:
            continue
        xy = parsed["xy"]
        status_code = xy.replace(" ", "")
        bucket = "other"
        if xy == "??":
            bucket = "untracked"
        elif "R" in status_code:
            bucket = "renamed"
        elif "D" in status_code:
            bucket = "deleted"
        elif "A" in status_code:
            bucket = "added"
        elif "M" in status_code:
            bucket = "modified"
        counts[bucket] += 1
        parsed["category"] = bucket
        changed_files.append(parsed)

    return {
        "tracked": True,
        "head": head,
        "shortHead": short_head,
        "changedCounts": counts,
        "changedFiles": changed_files,
    }


DEPENDENCY_MARKERS = {
    "package.json",
    "bun.lock",
    "bun.lockb",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "go.mod",
    "go.sum",
    "Cargo.toml",
    "Cargo.lock",
    "requirements.txt",
    "requirements-dev.txt",
    "Pipfile",
    "Pipfile.lock",
    "poetry.lock",
    "Gemfile",
    "Gemfile.lock",
}


def infer_risk_flags(git_snapshot, verify_snapshot, test_snapshot):
    flags = []
    paths = [item["path"] for item in git_snapshot["changedFiles"]]

    def add_flag(flag_id, severity, detail):
        if any(existing["id"] == flag_id for existing in flags):
            return
        flags.append({"id": flag_id, "severity": severity, "detail": detail})

    if dirty_state == "dirty":
        add_flag("dirty-worktree", "warn", "Workspace has uncommitted changes.")
    if verify_snapshot["status"] in {"never-run", "report-missing"}:
        add_flag("unverified", "warn", "No reusable verify snapshot is available.")
    elif verify_snapshot["status"] == "failing":
        add_flag("verify-failing", "high", "Latest verify snapshot is failing.")
    elif verify_snapshot["status"] == "warnings":
        add_flag("verify-warnings", "warn", "Latest verify snapshot has warnings.")

    if test_snapshot["status"] in {"never-run", "report-missing"}:
        add_flag("untested", "warn", "No reusable test snapshot is available.")
    elif test_snapshot["status"] == "failing":
        add_flag("test-failures", "high", "Latest test snapshot is failing.")
    elif test_snapshot["status"] == "warnings":
        add_flag("test-warnings", "warn", "Latest test snapshot has warnings.")

    if any(Path(item).name in DEPENDENCY_MARKERS for item in paths):
        add_flag("dependency-change", "warn", "Dependency manifest or lockfile changed.")
    if any(
        "migration" in item.lower() or "migrations/" in item.lower() or "supabase/" in item.lower()
        for item in paths
    ):
        add_flag("migration-touch", "high", "Database or migration paths changed.")
    if any(
        token in item.lower()
        for item in paths
        for token in ("auth", "oauth", "session", "permission", "policy", "role")
    ):
        add_flag("auth-touch", "high", "Authentication, authorization, or policy paths changed.")
    if any(
        token in item.lower()
        for item in paths
        for token in (".env", "config", "settings", "version.json", "appcast", "plist")
    ):
        add_flag("config-touch", "warn", "Configuration-bearing paths changed.")
    if any(item["category"] in {"deleted", "renamed"} for item in git_snapshot["changedFiles"]):
        add_flag("destructive-file-op", "high", "Deleted or renamed files are present in the worktree.")

    return flags


def changed_summary(counts):
    ordered = []
    for key in ("modified", "added", "deleted", "renamed", "untracked", "other"):
        value = counts.get(key, 0)
        if value:
            ordered.append(f"{key}={value}")
    return "; ".join(ordered) if ordered else "clean"


def risk_summary(flags):
    counts = {}
    labels = []
    for flag in flags:
        severity = flag.get("severity") or "unknown"
        counts[severity] = counts.get(severity, 0) + 1
        labels.append(f"{flag.get('id') or 'unknown'}({severity})")
    return {
        "count": len(flags),
        "bySeverity": counts,
        "ids": [flag.get("id") or "" for flag in flags],
        "summaryText": ", ".join(labels) if labels else "none",
    }


verify_snapshot = parse_snapshot(os.environ.get("AGENTS_CONTEXT_VERIFY_SNAPSHOT", ""), "verify")
test_snapshot = parse_snapshot(os.environ.get("AGENTS_CONTEXT_TEST_SNAPSHOT", ""), "test")
git_snapshot = build_git_snapshot(root)
short_head = git_snapshot.get("shortHead") or git_snapshot.get("head") or "-"
context_key = f"{workspace_identity}|{branch or '-'}|{short_head}"
flags = infer_risk_flags(git_snapshot, verify_snapshot, test_snapshot)

payload = {
    "schemaVersion": 1,
    "repoSnapshot": {
        "branch": branch,
        "dirtyState": dirty_state,
        "head": git_snapshot.get("head", ""),
        "shortHead": git_snapshot.get("shortHead", ""),
        "tracked": git_snapshot.get("tracked", False),
        "changedSummary": changed_summary(git_snapshot.get("changedCounts", {})),
        "changedCounts": git_snapshot.get("changedCounts", {}),
        "changedFiles": git_snapshot.get("changedFiles", []),
        "contextKey": context_key,
    },
    "riskFlags": flags,
    "riskSummary": risk_summary(flags),
}

json.dump(payload, sys.stdout, indent=2)
sys.stdout.write("\n")
PY
}

