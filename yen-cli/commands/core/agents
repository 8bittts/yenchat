cmd_templates() {
    local sub="${1:-list}"
    local project_target=""
    local template_name=""
    local dry_run="0"
    local root=""
    local row=""
    local seen_file=""

    shift || true
    case "${sub}" in
        list|ls)
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --project|--path)
                        shift
                        project_target="${1:-}"
                        ;;
                    *)
                        yen_error "Unknown templates list option: $1"
                        exit 1
                        ;;
                esac
                shift
            done

            root=$(find_project_root "${project_target}")
            seen_file=$(mktemp)
            : > "${seen_file}"

            echo ""
            yen_header "Workspace Templates"
            echo "Project: ${root}"
            echo ""
            printf "%-16s %-8s %-10s %-28s %s\n" "NAME" "SCHEMA" "SOURCE" "SLOTS" "DESCRIPTION"

            if [[ -d "${root}/.yen/workspaces" ]]; then
                while IFS= read -r line; do
                    [[ -z "${line}" ]] && continue
                    local parsed
                    local name=""
                    local description=""
                    local slots=""
                    local schema=""
                    local source=""
                    parsed=$(parse_workspace_template_file "${line}" "$(basename "${line}" .toml)" || true)
                    [[ -z "${parsed}" ]] && continue
                    IFS=$'\t' read -r name description slots schema source << EOF
${parsed}
EOF
                    echo "${name}" >> "${seen_file}"
                    printf "%-16s %-8s %-10s %-28s %s\n" "${name}" "${schema}" "${source}" "${slots}" "${description}"
                done < <(find "${root}/.yen/workspaces" -maxdepth 1 -type f -name '*.toml' 2>/dev/null | sort)
            fi

            while IFS= read -r row; do
                [[ -z "${row}" ]] && continue
                local name=""
                local description=""
                local slots=""
                local schema=""
                local source=""
                IFS=$'\t' read -r name description slots schema source << EOF
${row}
EOF
                if grep -Fxq -- "${name}" "${seen_file}" 2>/dev/null; then
                    continue
                fi
                printf "%-16s %-8s %-10s %-28s %s\n" "${name}" "${schema}" "${source}" "${slots}" "${description}"
            done << EOF
$(workspace_builtin_catalog)
EOF

            rm -f "${seen_file}"
            echo ""
            ;;
        show)
            if [[ $# -lt 1 ]]; then
                yen_error "templates show requires a template name."
                exit 1
            fi
            template_name="$1"
            shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --project|--path)
                        shift
                        project_target="${1:-}"
                        ;;
                    *)
                        yen_error "Unknown templates show option: $1"
                        exit 1
                        ;;
                esac
                shift
            done
            root=$(find_project_root "${project_target}")
            row=$(find_workspace_template "${root}" "${template_name}" || true)
            if [[ -z "${row}" ]]; then
                yen_error "Unknown workspace template '${template_name}'. Run: yen agents templates list"
                exit 1
            fi
            IFS=$'\t' read -r template_name description _slots _schema _source << EOF
${row}
EOF
            apply_workspace_template "${root}" "${template_name}" "1" "0"
            ;;
        apply)
            if [[ $# -lt 1 ]]; then
                yen_error "templates apply requires a template name."
                exit 1
            fi
            template_name="$1"
            shift
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --project|--path)
                        shift
                        project_target="${1:-}"
                        ;;
                    --dry-run)
                        dry_run="1"
                        ;;
                    *)
                        yen_error "Unknown templates apply option: $1"
                        exit 1
                        ;;
                esac
                shift
            done
            root=$(find_project_root "${project_target}")
            apply_workspace_template "${root}" "${template_name}" "${dry_run}" "0"
            ;;
        *)
            yen_error "Unknown templates subcommand: ${sub}"
            exit 1
            ;;
    esac
}

cmd_open() {
    local profile_name=""
    local dry_run="0"
    local passthrough=()
    local project_target=""
    local root=""
    local workspace_identity=""
    local branch=""
    local dirty_state=""
    local launch_mode="adapter"
    local session_id=""
    local started_at=""
    local stopped_at=""
    local exit_code=0
    local exit_label=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile)
                shift
                profile_name="${1:-}"
                ;;
            --project|--path)
                shift
                project_target="${1:-}"
                ;;
            --dry-run)
                dry_run="1"
                ;;
            --)
                shift
                while [[ $# -gt 0 ]]; do
                    passthrough+=("$1")
                    shift
                done
                break
                ;;
            *)
                if [[ -z "${profile_name}" ]]; then
                    profile_name="$1"
                else
                    passthrough+=("$1")
                fi
                ;;
        esac
        shift
    done

    if [[ -z "${profile_name}" ]]; then
        yen_error "open requires an adapter/profile. Example: yen agents open claude"
        exit 1
    fi

    root=$(find_project_root "${project_target}")

    local row=""
    row=$(find_adapter_row "${profile_name}" || true)
    if [[ -z "${row}" ]]; then
        # Treat unknown adapter name as workspace profile.
        apply_workspace_template "${root}" "${profile_name}" "${dry_run}" "1"
        return $?
    fi

    local name=""
    local binary_name=""
    local probe_cmd=""
    local capabilities=""
    local binary_path=""
    local probe_info=""
    local probe_status=""
    local probe_version=""
    local launch_result=""
    local fallback_state="none"
    IFS=$'\t' read -r name binary_name probe_cmd capabilities << EOF
${row}
EOF

    binary_path=$(resolve_adapter_binary_path "${binary_name}")
    probe_info=$(probe_adapter_status "${binary_name}" "${probe_cmd}")
    IFS='|' read -r probe_status probe_version << EOF
${probe_info}
EOF

    workspace_identity=$(agents_workspace_identity_for_root "${root}")
    branch=$(agents_git_branch_for_root "${root}")
    dirty_state=$(agents_git_dirty_state_for_root "${root}")

    if ! command -v "${binary_name}" >/dev/null 2>&1; then
        yen_warn "Adapter '${name}' is unavailable (binary '${binary_name}' not found)."
        if [[ "${dry_run}" == "1" ]]; then
            yen_info "Dry run: would fall back to normal shell session."
            return 0
        fi

        if [[ -t 0 && -t 1 ]]; then
            launch_mode="shell-fallback"
            launch_result="fallback"
            fallback_state="binary-missing"
            session_id=$(generate_agents_session_id)
            started_at=$(agents_iso_now)
            agents_write_session_state_best_effort "${session_id}" "${profile_name}" "${name}" "${workspace_identity}" "${root}" "${branch}" "${dirty_state}" "${launch_mode}" "running" "${started_at}" "" "" "${binary_name}" "${binary_path}" "${probe_cmd}" "${probe_status}" "${probe_version}" "${capabilities}" "${launch_result}" "${fallback_state}"
            agents_timeline_log_best_effort "session-start" "${root}" "fallback" "session=${session_id};slot=${profile_name};adapter=${name};branch=${branch};dirty=${dirty_state};launch_mode=${launch_mode};workspace_identity=${workspace_identity};started_at=${started_at};binary_name=${binary_name};binary_path=${binary_path};probe_command=${probe_cmd};probe_status=${probe_status};probe_version=${probe_version};declared_capabilities=${capabilities};launch_result=${launch_result};fallback_state=${fallback_state}"
            yen_warn "Falling back to normal shell session (fail-open)."
            set +e
            "${SHELL:-/bin/bash}" -l
            exit_code=$?
            set -e
            exit_label=$(agents_session_exit_status_label "${exit_code}")
            stopped_at=$(agents_iso_now)
            agents_write_session_state_best_effort "${session_id}" "${profile_name}" "${name}" "${workspace_identity}" "${root}" "${branch}" "${dirty_state}" "${launch_mode}" "stopped" "${started_at}" "${stopped_at}" "${exit_code}" "${binary_name}" "${binary_path}" "${probe_cmd}" "${probe_status}" "${probe_version}" "${capabilities}" "${launch_result}" "${fallback_state}"
            agents_timeline_log_best_effort "session-stop" "${root}" "status=${exit_label};exit=${exit_code}" "session=${session_id};slot=${profile_name};adapter=${name};branch=${branch};dirty=${dirty_state};launch_mode=${launch_mode};workspace_identity=${workspace_identity};started_at=${started_at};stopped_at=${stopped_at};binary_name=${binary_name};binary_path=${binary_path};probe_command=${probe_cmd};probe_status=${probe_status};probe_version=${probe_version};declared_capabilities=${capabilities};launch_result=${launch_result};fallback_state=${fallback_state}"
            return "${exit_code}"
        fi

        yen_info "Non-interactive mode: exiting cleanly without adapter launch."
        return 0
    fi

    if [[ "${dry_run}" == "1" ]]; then
        local cmd_preview="${binary_name}"
        local arg
        for arg in "${passthrough[@]}"; do
            cmd_preview="${cmd_preview} ${arg}"
        done
        yen_info "Dry run: would launch '${name}' via: ${cmd_preview}"
        return 0
    fi

    session_id=$(generate_agents_session_id)
    started_at=$(agents_iso_now)
    launch_result="launched"
    agents_write_session_state_best_effort "${session_id}" "${profile_name}" "${name}" "${workspace_identity}" "${root}" "${branch}" "${dirty_state}" "${launch_mode}" "running" "${started_at}" "" "" "${binary_name}" "${binary_path}" "${probe_cmd}" "${probe_status}" "${probe_version}" "${capabilities}" "${launch_result}" "${fallback_state}"
    agents_timeline_log_best_effort "session-start" "${root}" "launched" "session=${session_id};slot=${profile_name};adapter=${name};branch=${branch};dirty=${dirty_state};launch_mode=${launch_mode};workspace_identity=${workspace_identity};started_at=${started_at};binary_name=${binary_name};binary_path=${binary_path};probe_command=${probe_cmd};probe_status=${probe_status};probe_version=${probe_version};declared_capabilities=${capabilities};launch_result=${launch_result};fallback_state=${fallback_state}"

    set +e
    "${binary_name}" "${passthrough[@]}"
    exit_code=$?
    set -e

    exit_label=$(agents_session_exit_status_label "${exit_code}")
    stopped_at=$(agents_iso_now)
    agents_write_session_state_best_effort "${session_id}" "${profile_name}" "${name}" "${workspace_identity}" "${root}" "${branch}" "${dirty_state}" "${launch_mode}" "stopped" "${started_at}" "${stopped_at}" "${exit_code}" "${binary_name}" "${binary_path}" "${probe_cmd}" "${probe_status}" "${probe_version}" "${capabilities}" "${launch_result}" "${fallback_state}"
    agents_timeline_log_best_effort "session-stop" "${root}" "status=${exit_label};exit=${exit_code}" "session=${session_id};slot=${profile_name};adapter=${name};branch=${branch};dirty=${dirty_state};launch_mode=${launch_mode};workspace_identity=${workspace_identity};started_at=${started_at};stopped_at=${stopped_at};binary_name=${binary_name};binary_path=${binary_path};probe_command=${probe_cmd};probe_status=${probe_status};probe_version=${probe_version};declared_capabilities=${capabilities};launch_result=${launch_result};fallback_state=${fallback_state}"
    return "${exit_code}"
}

main() {
    case "${1:-}" in
        ""|-h|--help|help)
            show_help
            ;;
        list|ls|status)
            shift
            cmd_list "$@"
            ;;
        open|run|start)
            shift
            ensure_agents_state_dirs >/dev/null 2>&1 || true
            cmd_open "$@"
            ;;
        timeline)
            shift
            ensure_agents_state_dirs >/dev/null 2>&1 || true
            cmd_timeline "$@"
            ;;
        note)
            shift
            ensure_agents_state_dirs
            cmd_note "$@"
            ;;
        export)
            shift
            ensure_agents_state_dirs >/dev/null 2>&1 || true
            cmd_export "$@"
            ;;
        templates|template|workspace|workspaces)
            shift
            ensure_agents_state_dirs >/dev/null 2>&1 || true
            cmd_templates "$@"
            ;;
        *)
            yen_error "Unknown agents command: $1"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
