def merge_grouped_session_state(grouped, session_state):
    row = session_row_from_session_state(session_state)
    if row is None:
        return
    adapter_name = session_state.get("adapter", "")
    grouped.setdefault(adapter_name, {})[row["sessionId"]] = row


def build_grouped_adapter_sessions_from_events(events):
    grouped = {}
    for event in events:
        session_state = event.get("sessionState")
        if session_state:
            merge_grouped_session_state(grouped, session_state)
    return grouped


def build_grouped_adapter_sessions_from_persisted():
    grouped = {}
    session_root = Path(session_dir)
    if not session_root.exists():
        return grouped

    for path in sorted(session_root.glob("*.state")):
        try:
            payload = parse_kv_lines(path.read_text(encoding="utf-8"))
        except OSError:
            continue
        if not payload:
            continue

        payload_workspace = payload.get("workspace_identity", "")
        payload_project = payload.get("project_root", "")
        workspace_matches = False
        if payload_workspace:
            workspace_matches = payload_workspace in {workspace_identity, project_root}
        elif payload_project:
            workspace_matches = payload_project == project_root
        else:
            continue
        if not workspace_matches:
            continue

        session_state = session_state_with_schema(payload)
        try:
            session_state["_mtimeNs"] = path.stat().st_mtime_ns
        except OSError:
            session_state["_mtimeNs"] = 0
        merge_grouped_session_state(grouped, session_state)

    return grouped


def build_grouped_adapter_sessions_from_timeline():
    grouped = {}
    for payload in timeline_session_states().values():
        session_state = session_state_with_schema(payload)
        session_state["_mtimeNs"] = int(payload.get("_mtimeNs", 0) or 0)
        merge_grouped_session_state(grouped, session_state)
    return grouped


def merge_grouped_adapter_sessions(*groups):
    merged = {}
    for group in groups:
        for adapter_name, sessions in group.items():
            adapter_group = merged.setdefault(adapter_name, {})
            for session_id, session_row in sessions.items():
                adapter_group[session_id] = session_row
    return merged


def git_repo_exists(root):
    return os.path.isdir(os.path.join(root, ".git")) or os.path.isfile(os.path.join(root, ".git"))


def git_command(root, *args):
    return subprocess.run(
        ["git", "-C", root, *args],
        capture_output=True,
        text=True,
        check=False,
    )


def parse_status_line(line):
    if len(line) < 3:
        return None
    xy = line[:2]
    path_text = line[3:]
    previous_path = ""
    if " -> " in path_text:
        previous_path, path_text = path_text.split(" -> ", 1)
    return {
        "xy": xy,
        "path": path_text,
        "previousPath": previous_path,
    }


def build_git_snapshot(root):
    if not git_repo_exists(root):
        return {
            "tracked": False,
            "head": "",
            "shortHead": "",
            "changedCounts": {},
            "changedFiles": [],
        }

    head = ""
    short_head = ""
    head_proc = git_command(root, "rev-parse", "HEAD")
    if head_proc.returncode == 0:
        head = head_proc.stdout.strip()
    short_proc = git_command(root, "rev-parse", "--short", "HEAD")
    if short_proc.returncode == 0:
        short_head = short_proc.stdout.strip()

    status_proc = git_command(root, "status", "--porcelain=1", "--untracked-files=all")
    changed_files = []
    counts = {
        "modified": 0,
        "added": 0,
        "deleted": 0,
        "renamed": 0,
        "untracked": 0,
        "other": 0,
    }
    for raw in status_proc.stdout.splitlines():
        parsed = parse_status_line(raw)
        if parsed is None:
            continue
        xy = parsed["xy"]
        status_code = xy.replace(" ", "")
        bucket = "other"
        if xy == "??":
            bucket = "untracked"
        elif "R" in status_code:
            bucket = "renamed"
        elif "D" in status_code:
            bucket = "deleted"
        elif "A" in status_code:
            bucket = "added"
        elif "M" in status_code:
            bucket = "modified"
        counts[bucket] += 1
        parsed["category"] = bucket
        changed_files.append(parsed)

    return {
        "tracked": True,
        "head": head,
        "shortHead": short_head,
        "changedCounts": counts,
        "changedFiles": changed_files,
    }


DEPENDENCY_MARKERS = {
    "package.json",
    "bun.lock",
    "bun.lockb",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "go.mod",
