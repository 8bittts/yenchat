import json
import os
import sys

filtered_file, session_dir, note_dir, timeline_file, project_root, workspace_identity = sys.argv[1:7]


def parse_kv_lines(text):
    payload = {}
    for line in text.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        payload[key] = value
    return payload


def parse_snapshot(text, prefix):
    payload = parse_kv_lines(text)
    return {
        "status": payload.get(f"{prefix}_status", "never-run"),
        "lastRunAt": payload.get(f"{prefix}_last_run_at", ""),
        "summary": payload.get(f"{prefix}_summary", ""),
        "details": payload.get(f"{prefix}_details", ""),
        "semantic": payload.get(f"{prefix}_semantic", ""),
        "failures": int(payload.get(f"{prefix}_failures", "0") or "0"),
        "warns": int(payload.get(f"{prefix}_warns", "0") or "0"),
        "executed": int(payload.get(f"{prefix}_executed", "0") or "0"),
    }


def parse_json_payload(text, fallback):
    raw = str(text or "").strip()
    if not raw:
        return fallback
    try:
        return json.loads(raw)
    except Exception:
        return fallback


def parse_detail(detail):
    payload = {}
    for item in detail.split(";"):
        item = item.strip()
        if not item or "=" not in item:
            continue
        key, value = item.split("=", 1)
        payload[key] = value
    return payload


def workspace_matches(payload_workspace, payload_project):
    if payload_workspace:
        return payload_workspace in {workspace_identity, project_root}
    if payload_project:
        return payload_project == project_root
    return False


_timeline_session_states = None


def timeline_session_states():
    global _timeline_session_states
    if _timeline_session_states is not None:
        return _timeline_session_states

    session_map = {}
    if os.path.exists(timeline_file):
        with open(timeline_file, "r", encoding="utf-8") as handle:
            for line_number, raw in enumerate(handle):
                raw = raw.rstrip("\n")
                if not raw:
                    continue
                parts = raw.split("\t", 4)
                if len(parts) < 5:
                    continue
                timestamp, event, root_key, status, detail_text = parts
                if root_key != project_root:
                    continue
                if event not in {"session-start", "session-stop"}:
                    continue
                detail = parse_detail(detail_text)
                session_id = detail.get("session", "")
                if not session_id:
                    continue
                if not workspace_matches(detail.get("workspace_identity", ""), root_key):
                    continue
                payload = session_map.setdefault(
                    session_id,
                    {
                        "session_id": session_id,
                        "slot_id": "",
                        "adapter": "",
                        "workspace_identity": "",
                        "project_root": root_key,
                        "branch": "",
                        "dirty_state": "",
                        "launch_mode": "",
                        "lifecycle_state": "",
                        "started_at": "",
                        "stopped_at": "",
                        "exit_code": "0",
                        "binary_name": "",
                        "binary_path": "",
                        "probe_command": "",
                        "probe_status": "",
                        "probe_version": "",
                        "declared_capabilities": "",
                        "launch_result": "",
                        "fallback_state": "",
                        "_mtimeNs": 0,
                    },
                )
                for detail_key, payload_key in (
                    ("slot", "slot_id"),
                    ("adapter", "adapter"),
                    ("branch", "branch"),
                    ("dirty", "dirty_state"),
                    ("launch_mode", "launch_mode"),
                    ("binary_name", "binary_name"),
                    ("binary_path", "binary_path"),
                    ("probe_command", "probe_command"),
                    ("probe_status", "probe_status"),
                    ("probe_version", "probe_version"),
                    ("declared_capabilities", "declared_capabilities"),
                    ("launch_result", "launch_result"),
                    ("fallback_state", "fallback_state"),
                ):
                    if detail_key in detail:
                        payload[payload_key] = detail[detail_key]
                payload["workspace_identity"] = (
                    detail.get("workspace_identity", "") or payload.get("workspace_identity", "") or root_key
                )
                payload["project_root"] = root_key
                if "started_at" in detail:
                    payload["started_at"] = detail["started_at"] or payload.get("started_at", "")
                elif event == "session-start" and not payload.get("started_at", ""):
                    payload["started_at"] = timestamp
                if event == "session-start":
                    payload["lifecycle_state"] = "running"
                if event == "session-stop":
                    payload["lifecycle_state"] = "stopped"
                    payload["stopped_at"] = detail.get("stopped_at", "") or timestamp
                    status_fields = parse_detail(status)
                    if "exit" in status_fields:
                        payload["exit_code"] = status_fields["exit"]
                payload["_mtimeNs"] = max(int(payload.get("_mtimeNs", 0) or 0), line_number)

    _timeline_session_states = session_map
    return _timeline_session_states


