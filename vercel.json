{
	"regions": ["pdx1"],
	"ignoreCommand": "if echo \"$VERCEL_GIT_COMMIT_MESSAGE\" | head -1 | grep -q '\\[deploy\\]'; then exit 1; fi",
	"headers": [
		{
			"source": "/stable/appcast.xml",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, stale-while-revalidate=60"
				}
			]
		},
		{
			"source": "/stable/version.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, stale-while-revalidate=60"
				}
			]
		},
		{
			"source": "/stable/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
				}
			]
		},
		{
			"source": "/favicons/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/doc-images/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/_next/static/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=31536000; includeSubDomains; preload"
				},
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "same-origin"
				},
				{
					"key": "Cross-Origin-Resource-Policy",
					"value": "same-origin"
				},
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), browsing-topics=(), payment=(), usb=()"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/features",
			"destination": "/#guide",
			"permanent": true
		},
		{
			"source": "/integrations",
			"destination": "/#guide",
			"permanent": true
		},
		{
			"source": "/github",
			"destination": "https://github.com/8bittts/yenchat",
			"permanent": false
		},
		{
			"source": "/discord",
			"destination": "https://discord.gg/yen",
			"permanent": false
		},
		{
			"source": "/twitter",
			"destination": "https://twitter.com/yenFTW",
			"permanent": false
		}
	],
	"installCommand": "node scripts/run-pinned-bun.cjs install",
	"buildCommand": "node scripts/run-pinned-bun.cjs build"
}
