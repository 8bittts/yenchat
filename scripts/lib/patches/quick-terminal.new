        // Toggle fullscreen
        try self.set.put(
            alloc,
            .{ .key = .{ .physical = .enter }, .mods = inputpkg.ctrlOrSuper(.{}) },
            .{ .toggle_fullscreen = {} },
        );


        // Toggle quick terminal (YEN default — Ctrl+`)
        try self.set.putFlags(
            alloc,
            .{ .key = .{ .physical = .backquote }, .mods = .{ .ctrl = true } },
            .{ .toggle_quick_terminal = {} },
            .{ .global = true },
        );
