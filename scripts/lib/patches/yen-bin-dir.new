            var bin_buf: [std.Io.Dir.max_path_bytes]u8 = undefined;
            var exe_buf: [std.Io.Dir.max_path_bytes]u8 = undefined;
            var bin_dir: ?[]const u8 = null;

            // Prefer Resources/bin (where YEN bundles yen/yazi CLI tools and helpers)
            if (cfg.resources_dir) |resources_dir| {
                if (std.fs.path.dirname(resources_dir)) |resources_base| {
                    if (std.mem.print(&bin_buf, "{s}/bin", .{resources_base})) |candidate| {
                        if (std.Io.Dir.accessAbsolute(global.io(), candidate, .{})) |_| {
                            bin_dir = candidate;
                        } else |_| {}
                    } else |_| {}
                }
            }

            // Fall back to app executable directory (Contents/MacOS/)
            if (bin_dir == null) {
                const exe_bin_path = exe_buf[0 .. std.process.executablePath(
                    global.io(),
                    &exe_buf,
                ) catch |err| {
                    log.warn("failed to get yen exe path err={}", .{err});
                    break :yen_path;
                }];
                const exe_dir = std.fs.path.dirname(exe_bin_path) orelse break :yen_path;
                bin_dir = exe_dir;
            }

            log.debug("appending yen bin to path dir={s}", .{bin_dir.?});

            // We always set this so that if the shell overwrites the path
            // scripts still have a way to find the YEN binary when
            // running in YEN.
            try env.put("YEN_BIN_DIR", bin_dir.?);
