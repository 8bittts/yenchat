let arguments = CommandLine.arguments
var engineArguments: [UnsafeMutablePointer<CChar>?] = []
var index = 0
while index < arguments.count {
    let argument = arguments[index]
    if argument == "-e" || argument == "--" {
        engineArguments.append(contentsOf: (index..<arguments.count).map { CommandLine.unsafeArgv[$0] })
        break
    }
    if argument == "-com.yenchat.yen.hasCompletedSetup", index + 1 < arguments.count,
       ["yes", "no", "true", "false", "0", "1"].contains(arguments[index + 1].lowercased()) {
        index += 2
        continue
    }
    engineArguments.append(CommandLine.unsafeArgv[index])
    index += 1
}
let engineCount = engineArguments.count
engineArguments.append(nil)
// The engine retains argv for configuration reloads. AppKit receives the original argv.
let engineArgv = UnsafeMutablePointer<UnsafeMutablePointer<CChar>?>.allocate(capacity: engineArguments.count)
engineArgv.initialize(from: engineArguments, count: engineArguments.count)
defer { engineArgv.deallocate() }
if yen_init(UInt(engineCount), engineArgv) != YEN_SUCCESS {
